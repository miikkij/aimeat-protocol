{
  "architecture": "cortex-modular",
  "components": [
    {
      "id": "csm-1",
      "type": "csm",
      "label": "PRH Yritystietopalvelu – palvelumäärittely",
      "produces": ["memory:service.schema"],
      "consumes": []
    },
    {
      "id": "memory-1",
      "type": "memory",
      "label": "Oletusasetukset ja alkuarvot",
      "produces": ["memory:settings.config"],
      "consumes": []
    },
    {
      "id": "translation-1",
      "type": "translation",
      "label": "Käännökset (fi)",
      "produces": ["memory:i18n.fi"],
      "consumes": []
    },
    {
      "id": "translation-2",
      "type": "translation",
      "label": "Translations (en)",
      "produces": ["memory:i18n.en"],
      "consumes": []
    },
    {
      "id": "ext-1",
      "type": "extension",
      "label": "PRH Avoindata -rajapinta",
      "produces": ["memory:watchlist.items", "memory:companies.cache.*", "memory:changes.log"],
      "consumes": ["memory:settings.config", "memory:watchlist.items"],
      "schedules": [
        { "action": "init", "cron": "@activate" },
        { "action": "checkChanges", "cron": "0 6 * * *" }
      ]
    },
    {
      "id": "cortex-data",
      "type": "cortex",
      "subtype": "data",
      "label": "Yritysdata-kerros",
      "produces": ["api:searchCompanies", "api:getCompany", "api:getWatchlist", "api:addToWatchlist", "api:removeFromWatchlist", "api:getChanges", "api:getComparisons", "api:saveComparison", "api:getSettings", "api:saveSettings"],
      "consumes": ["memory:watchlist.items", "memory:companies.cache.*", "memory:changes.log", "memory:comparisons.saved", "memory:settings.config"],
      "uses": []
    },
    {
      "id": "cortex-feature-search",
      "type": "cortex",
      "subtype": "feature",
      "label": "Haku ja yritystiedot (UC-1 + UC-3)",
      "produces": ["ui:searchView", "ui:companyDetailView"],
      "consumes": ["api:searchCompanies", "api:getCompany", "api:addToWatchlist"],
      "uses": []
    },
    {
      "id": "cortex-feature-watchlist",
      "type": "cortex",
      "subtype": "feature",
      "label": "Seurantalista ja muutokset (UC-2 + UC-5)",
      "produces": ["ui:watchlistView", "ui:changesView"],
      "consumes": ["api:getWatchlist", "api:removeFromWatchlist", "api:getChanges", "api:getCompany"],
      "uses": []
    },
    {
      "id": "cortex-feature-compare",
      "type": "cortex",
      "subtype": "feature",
      "label": "Yritysvertailu (UC-4)",
      "produces": ["ui:compareView"],
      "consumes": ["api:getCompany", "api:getComparisons", "api:saveComparison", "api:searchCompanies"],
      "uses": []
    },
    {
      "id": "cortex-app",
      "type": "cortex",
      "subtype": "app-domain",
      "label": "PRH Yritystietopalvelu – sovellusalue",
      "produces": ["api:init", "api:render"],
      "consumes": ["ui:searchView", "ui:companyDetailView", "ui:watchlistView", "ui:changesView", "ui:compareView", "api:getSettings", "api:saveSettings"],
      "uses": []
    },
    {
      "id": "app-1",
      "type": "app",
      "label": "PRH Yritystietopalvelu",
      "produces": [],
      "consumes": ["api:init", "api:render"]
    }
  ],
  "phases": [
    { "id": "define", "label": "Palvelumäärittely", "componentIds": ["csm-1"] },
    { "id": "seed", "label": "Alkudata", "componentIds": ["memory-1", "translation-1", "translation-2"] },
    { "id": "logic", "label": "Rajapintakytkentä", "componentIds": ["ext-1"] },
    { "id": "cortex-data", "label": "Data-kerros", "componentIds": ["cortex-data"] },
    { "id": "cortex-features", "label": "Ominaisuuskomponentit", "componentIds": ["cortex-feature-search", "cortex-feature-watchlist", "cortex-feature-compare"] },
    { "id": "cortex-app", "label": "Sovellusalue", "componentIds": ["cortex-app"] },
    { "id": "ui", "label": "Sovellus", "componentIds": ["app-1"] }
  ],
  "dataModel": {
    "structures": {
      "BusinessId": {
        "type": "object",
        "properties": {
          "value": { "type": "string", "description": "Y-tunnus, e.g. 3323553-5" },
          "registrationDate": { "type": "string", "description": "ISO date, e.g. 2022-11-07" },
          "source": { "type": "string", "description": "Source code" }
        }
      },
      "EuId": {
        "type": "object",
        "properties": {
          "value": { "type": "string", "description": "EU identifier, e.g. FIFPRO.3323553-5" },
          "source": { "type": "string" }
        }
      },
      "LocalizedDescription": {
        "type": "object",
        "properties": {
          "languageCode": { "type": "string", "description": "1=fi, 2=sv, 3=en" },
          "description": { "type": "string" }
        }
      },
      "CompanyName": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "description": "Name type code" },
          "registrationDate": { "type": "string" },
          "version": { "type": "number" },
          "source": { "type": "string" }
        }
      },
      "MainBusinessLine": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "description": "TOL code, e.g. 62100" },
          "descriptions": { "type": "array", "items": { "$ref": "LocalizedDescription" } },
          "typeCodeSet": { "type": "string" },
          "registrationDate": { "type": "string" },
          "source": { "type": "string" }
        }
      },
      "Website": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "registrationDate": { "type": "string" },
          "source": { "type": "string" }
        }
      },
      "CompanyForm": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "description": "Form type code" },
          "descriptions": { "type": "array", "items": { "$ref": "LocalizedDescription" } },
          "registrationDate": { "type": "string" },
          "version": { "type": "number" },
          "source": { "type": "string" }
        }
      },
      "RegisteredEntry": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "descriptions": { "type": "array", "items": { "$ref": "LocalizedDescription" } },
          "registrationDate": { "type": "string" },
          "endDate": { "type": "string" },
          "register": { "type": "string" },
          "authority": { "type": "string" }
        }
      },
      "PostOffice": {
        "type": "object",
        "properties": {
          "city": { "type": "string" },
          "languageCode": { "type": "string" },
          "municipalityCode": { "type": "string" }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "type": { "type": "number" },
          "street": { "type": "string" },
          "postCode": { "type": "string" },
          "postOffices": { "type": "array", "items": { "$ref": "PostOffice" } },
          "postOfficeBox": { "type": "string" },
          "buildingNumber": { "type": "string" },
          "entrance": { "type": "string" },
          "apartmentNumber": { "type": "string" },
          "apartmentIdSuffix": { "type": "string" },
          "co": { "type": "string" },
          "registrationDate": { "type": "string" },
          "source": { "type": "string" }
        }
      },
      "Company": {
        "type": "object",
        "description": "Full company record from PRH API",
        "properties": {
          "businessId": { "$ref": "BusinessId" },
          "euId": { "$ref": "EuId" },
          "names": { "type": "array", "items": { "$ref": "CompanyName" } },
          "mainBusinessLine": { "$ref": "MainBusinessLine" },
          "website": { "$ref": "Website" },
          "companyForms": { "type": "array", "items": { "$ref": "CompanyForm" } },
          "companySituations": { "type": "array", "items": { "type": "object" } },
          "registeredEntries": { "type": "array", "items": { "$ref": "RegisteredEntry" } },
          "addresses": { "type": "array", "items": { "$ref": "Address" } },
          "tradeRegisterStatus": { "type": "string" },
          "status": { "type": "string" },
          "registrationDate": { "type": "string" },
          "lastModified": { "type": "string", "description": "ISO 8601 datetime" }
        }
      },
      "CompanySearchResult": {
        "type": "object",
        "properties": {
          "totalResults": { "type": "number" },
          "companies": { "type": "array", "items": { "$ref": "Company" } }
        }
      },
      "WatchlistItem": {
        "type": "object",
        "properties": {
          "businessId": { "type": "string", "description": "Y-tunnus value, e.g. 3323553-5" },
          "companyName": { "type": "string" },
          "addedAt": { "type": "string", "description": "ISO 8601 datetime" },
          "lastChecked": { "type": "string", "description": "ISO 8601 datetime" },
          "lastModified": { "type": "string", "description": "Last known lastModified from PRH API" }
        }
      },
      "Change": {
        "type": "object",
        "properties": {
          "businessId": { "type": "string" },
          "companyName": { "type": "string" },
          "detectedAt": { "type": "string", "description": "ISO 8601 datetime" },
          "field": { "type": "string", "description": "Changed field path" },
          "oldValue": { "type": "string" },
          "newValue": { "type": "string" }
        }
      },
      "SavedComparison": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "businessIds": { "type": "array", "items": { "type": "string" } },
          "companyNames": { "type": "array", "items": { "type": "string" } },
          "savedAt": { "type": "string", "description": "ISO 8601 datetime" },
          "notes": { "type": "string" }
        }
      },
      "Settings": {
        "type": "object",
        "properties": {
          "locale": { "type": "string", "enum": ["fi", "en"], "description": "UI language" },
          "changeCheckCron": { "type": "string", "description": "Cron for change detection, default 0 6 * * *" },
          "cacheHours": { "type": "number", "description": "Hours to cache company data, default 24" },
          "maxWatchlistSize": { "type": "number", "description": "Max companies in watchlist, default 50" }
        }
      }
    },
    "memoryKeys": {
      "settings.config": {
        "type": "object",
        "$ref": "Settings",
        "source": "config",
        "producedBy": "memory-1",
        "consumedBy": ["ext-1", "cortex-data"]
      },
      "i18n.fi": {
        "type": "object",
        "description": "Finnish translation strings",
        "source": "static",
        "producedBy": "translation-1",
        "consumedBy": ["cortex-app"]
      },
      "i18n.en": {
        "type": "object",
        "description": "English translation strings",
        "source": "static",
        "producedBy": "translation-2",
        "consumedBy": ["cortex-app"]
      },
      "watchlist.items": {
        "type": "array",
        "items": { "$ref": "WatchlistItem" },
        "source": "computed",
        "producedBy": "ext-1",
        "consumedBy": ["cortex-data", "ext-1"]
      },
      "companies.cache.*": {
        "type": "object",
        "$ref": "Company",
        "description": "Cached company data keyed by businessId value, e.g. companies.cache.3323553-5",
        "source": "external",
        "producedBy": "ext-1",
        "consumedBy": ["cortex-data"]
      },
      "changes.log": {
        "type": "array",
        "items": { "$ref": "Change" },
        "source": "computed",
        "producedBy": "ext-1",
        "consumedBy": ["cortex-data"]
      },
      "comparisons.saved": {
        "type": "array",
        "items": { "$ref": "SavedComparison" },
        "source": "computed",
        "producedBy": "cortex-data",
        "consumedBy": ["cortex-feature-compare"]
      }
    },
    "actions": {
      "ext:searchCompanies": {
        "input": { "query": { "type": "string", "description": "Company name or Y-tunnus" } },
        "output": { "$ref": "CompanySearchResult" }
      },
      "ext:getCompany": {
        "input": { "businessId": { "type": "string", "description": "Y-tunnus value, e.g. 3323553-5" } },
        "output": { "$ref": "Company" }
      },
      "ext:addToWatchlist": {
        "input": {
          "businessId": { "type": "string" },
          "companyName": { "type": "string" }
        },
        "output": { "$ref": "WatchlistItem" }
      },
      "ext:removeFromWatchlist": {
        "input": { "businessId": { "type": "string" } },
        "output": { "type": "object", "properties": { "removed": { "type": "boolean" } } }
      },
      "ext:checkChanges": {
        "input": {},
        "output": { "type": "object", "properties": { "changesDetected": { "type": "number" } } }
      },
      "ext:init": {
        "input": {},
        "output": { "type": "object", "properties": { "initialized": { "type": "boolean" } } }
      },
      "cortex:searchCompanies": {
        "input": { "query": { "type": "string" } },
        "output": { "$ref": "CompanySearchResult" }
      },
      "cortex:getCompany": {
        "input": { "businessId": { "type": "string" } },
        "output": { "$ref": "Company" }
      },
      "cortex:getWatchlist": {
        "input": {},
        "output": { "type": "array", "items": { "$ref": "WatchlistItem" } }
      },
      "cortex:addToWatchlist": {
        "input": { "businessId": { "type": "string" }, "companyName": { "type": "string" } },
        "output": { "$ref": "WatchlistItem" }
      },
      "cortex:removeFromWatchlist": {
        "input": { "businessId": { "type": "string" } },
        "output": { "type": "object", "properties": { "removed": { "type": "boolean" } } }
      },
      "cortex:getChanges": {
        "input": {},
        "output": { "type": "array", "items": { "$ref": "Change" } }
      },
      "cortex:getComparisons": {
        "input": {},
        "output": { "type": "array", "items": { "$ref": "SavedComparison" } }
      },
      "cortex:saveComparison": {
        "input": { "$ref": "SavedComparison" },
        "output": { "$ref": "SavedComparison" }
      },
      "cortex:getSettings": {
        "input": {},
        "output": { "$ref": "Settings" }
      },
      "cortex:saveSettings": {
        "input": { "$ref": "Settings" },
        "output": { "$ref": "Settings" }
      }
    }
  },
  "settings": {
    "locale": { "type": "string", "default": "fi", "description": "Käyttöliittymän kieli" },
    "changeCheckCron": { "type": "string", "default": "0 6 * * *", "description": "Muutosten tarkistusaikataulu" },
    "cacheHours": { "type": "number", "default": 24, "description": "Yritystietojen välimuistin kesto (tuntia)" },
    "maxWatchlistSize": { "type": "number", "default": 50, "description": "Seurantalistan maksimikoko" }
  },
  "testScenarios": [
    {
      "id": "search-by-name",
      "action": "searchCompanies",
      "input": { "query": "Overscale" },
      "expect": {
        "totalResults": { "gte": 1 },
        "companies[0].businessId.value": "3323553-5",
        "companies[0].names[0].name": { "contains": "Overscale" }
      },
      "description": "Search by company name returns results with correct businessId structure"
    },
    {
      "id": "search-by-businessid",
      "action": "searchCompanies",
      "input": { "query": "3323553-5" },
      "expect": {
        "totalResults": 1,
        "companies[0].businessId.value": "3323553-5"
      },
      "description": "Search by Y-tunnus returns exact match"
    },
    {
      "id": "get-company-detail",
      "action": "getCompany",
      "input": { "businessId": "3323553-5" },
      "expect": {
        "businessId.value": "3323553-5",
        "names": { "isArray": true, "minLength": 1 },
        "companyForms": { "isArray": true, "minLength": 1 },
        "addresses": { "isArray": true },
        "registeredEntries": { "isArray": true }
      },
      "description": "Get single company returns full record with all nested structures"
    },
    {
      "id": "add-to-watchlist",
      "action": "addToWatchlist",
      "input": { "businessId": "3323553-5", "companyName": "Overscale Solutions Oy" },
      "expect": {
        "businessId": "3323553-5",
        "companyName": "Overscale Solutions Oy",
        "addedAt": { "isString": true }
      },
      "description": "Add company to watchlist returns WatchlistItem"
    },
    {
      "id": "remove-from-watchlist",
      "action": "removeFromWatchlist",
      "input": { "businessId": "3323553-5" },
      "expect": {
        "removed": true
      },
      "description": "Remove company from watchlist succeeds"
    },
    {
      "id": "init-idempotent",
      "action": "init",
      "input": {},
      "expect": {
        "initialized": true
      },
      "description": "Init action is idempotent — safe to run multiple times"
    },
    {
      "id": "search-no-results",
      "action": "searchCompanies",
      "input": { "query": "XyzNonExistentCompany99999" },
      "expect": {
        "totalResults": 0,
        "companies": { "isArray": true, "length": 0 }
      },
      "description": "Search with no matches returns empty results"
    }
  ]
}
