{
  "name": "aimeat",
  "version": "3.3.3",
  "description": "AIME AT - AI Memory Exchange and Action Transfer - reference implementation",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "aimeat": "dist/bin/aimeat.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist/",
    "scripts/vendor-libs.mjs",
    "docs/AIMEAT_Help_Prompt.md",
    "docs/csm-examples/"
  ],
  "scripts": {
    "postinstall": "node scripts/vendor-libs.mjs --optional",
    "vendor:libs": "node scripts/vendor-libs.mjs",
    "check:vendored": "node scripts/vendor-libs.mjs --check",
    "dev": "node scripts/vendor-libs.mjs && tsx scripts/kill-port.ts && tsx scripts/build-app-catalog.ts && tsx scripts/build-sdk-libs.ts && node --env-file=.env --import tsx src/index.ts start",
    "dev:watch": "tsx watch src/index.ts",
    "build": "node scripts/vendor-libs.mjs && tsc && node --input-type=module -e \"import fs from 'fs';fs.cpSync('locales','dist/locales',{recursive:true});fs.cpSync('public','dist/public',{recursive:true});fs.cpSync('src/static','dist/static',{recursive:true});fs.cpSync('.env.example','dist/.env.example');fs.cpSync('docs','dist/docs',{recursive:true});fs.cpSync('src/storage/providers/postgres-kysely/migrations','dist/src/storage/providers/postgres-kysely/migrations',{recursive:true});\" && node scripts/write-build-stamp.mjs",
    "build:app-catalog": "tsx scripts/build-app-catalog.ts",
    "check:app-catalog": "tsx scripts/build-app-catalog.ts --check",
    "check:changelog": "tsx scripts/check-changelog.ts",
    "check:commit-msg": "tsx scripts/check-commit-msg.ts",
    "build:sdk": "tsx scripts/build-sdk-libs.ts",
    "check:sdk": "tsx scripts/build-sdk-libs.ts --check",
    "check:mcp-tools": "tsx scripts/audit-mcp-tools.ts --check",
    "check:mcp-schemas": "tsx scripts/audit-mcp-schemas.ts --check",
    "check:plain-language": "tsx scripts/check-plain-language.ts --check",
    "check:packs-doc": "vitest run test/unit/library-packs-doc-truth.test.ts",
    "aeb:prove": "tsx scripts/aeb-prove.ts",
    "aeb:ledger": "tsx scripts/aeb-ledger.ts",
    "start": "node --env-file=.env dist/src/index.js start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:api": "tsx test/api-full.ts",
    "test:e2e:admin-features": "tsx test/e2e-admin-features.ts",
    "test:e2e:anonymous": "tsx test/e2e-anonymous.ts",
    "test:e2e:auth-lib": "tsx test/e2e-auth-lib.ts",
    "test:e2e:board-ttl": "tsx test/e2e-board-ttl.ts",
    "test:e2e:calibrator": "tsx test/e2e-calibrator.ts",
    "test:e2e:concurrency": "tsx test/e2e-concurrency.ts",
    "test:e2e:disputes": "tsx test/e2e-disputes.ts",
    "test:e2e:extensions": "tsx test/e2e-extensions.ts",
    "test:e2e:federation": "tsx test/e2e-federation.ts",
    "test:e2e:federation-mesh": "tsx test/federation-mesh.ts",
    "test:e2e:federation-multinode": "tsx test/federation-multinode.ts",
    "test:e2e:hooks": "tsx test/e2e-hooks.ts",
    "test:e2e:knowledge": "tsx test/e2e-knowledge.ts",
    "test:e2e:libs": "tsx test/e2e-libs.ts",
    "test:e2e:mcp": "tsx test/e2e-mcp.ts",
    "test:e2e:micro-memory": "tsx test/e2e-micro-memory.ts",
    "test:e2e:packages": "tsx test/e2e-packages.ts",
    "test:e2e:personal-node": "tsx test/e2e-personal-node.ts",
    "test:e2e:phase0": "tsx test/e2e-phase0.ts",
    "test:e2e:portal": "tsx test/e2e-portal.ts",
    "test:e2e:security": "tsx test/e2e-security.ts",
    "test:e2e:storage-visibility": "tsx test/e2e-storage-visibility.ts",
    "test:e2e:cortex-ui": "tsx test/cortex-ui-e2e.ts",
    "test:e2e:docker": "bash test/docker/e2e-runner.sh --all",
    "test:e2e:docker:full": "bash test/docker/e2e-runner.sh test/api-full.ts",
    "test:e2e:docker:admin-features": "bash test/docker/e2e-runner.sh test/e2e-admin-features.ts",
    "test:e2e:docker:anonymous": "bash test/docker/e2e-runner.sh test/e2e-anonymous.ts",
    "test:e2e:docker:auth-lib": "bash test/docker/e2e-runner.sh test/e2e-auth-lib.ts",
    "test:e2e:docker:board-ttl": "bash test/docker/e2e-runner.sh test/e2e-board-ttl.ts",
    "test:e2e:docker:concurrency": "bash test/docker/e2e-runner.sh test/e2e-concurrency.ts",
    "test:e2e:docker:disputes": "bash test/docker/e2e-runner.sh test/e2e-disputes.ts",
    "test:e2e:docker:extensions": "bash test/docker/e2e-runner.sh test/e2e-extensions.ts",
    "test:e2e:docker:federation": "bash test/docker/e2e-runner.sh test/e2e-federation.ts",
    "test:e2e:docker:hooks": "bash test/docker/e2e-runner.sh test/e2e-hooks.ts",
    "test:e2e:docker:knowledge": "bash test/docker/e2e-runner.sh test/e2e-knowledge.ts",
    "test:e2e:docker:libs": "bash test/docker/e2e-runner.sh test/e2e-libs.ts",
    "test:e2e:docker:mcp": "bash test/docker/e2e-runner.sh test/e2e-mcp.ts",
    "test:e2e:docker:micro-memory": "bash test/docker/e2e-runner.sh test/e2e-micro-memory.ts",
    "test:e2e:docker:packages": "bash test/docker/e2e-runner.sh test/e2e-packages.ts",
    "test:e2e:docker:personal-node": "bash test/docker/e2e-runner.sh test/e2e-personal-node.ts",
    "test:e2e:docker:phase0": "bash test/docker/e2e-runner.sh test/e2e-phase0.ts",
    "test:e2e:docker:portal": "bash test/docker/e2e-runner.sh test/e2e-portal.ts",
    "test:e2e:docker:security": "bash test/docker/e2e-runner.sh test/e2e-security.ts",
    "test:e2e:docker:storage-visibility": "bash test/docker/e2e-runner.sh test/e2e-storage-visibility.ts",
    "test:e2e": "node --env-file=.env.test.memory --import tsx test/run-e2e-ci.ts",
    "test:e2e:memory": "node --env-file=.env.test.memory --import tsx test/run-e2e-ci.ts",
    "test:e2e:guards:sqlite": "tsx scripts/kill-test-servers.ts && node --env-file=.env.test.sqlite --import tsx test/run-e2e-ci.ts --guards",
    "test:e2e:guards:postgres-kysely": "tsx scripts/kill-test-servers.ts && node --env-file=.env.test.postgres-kysely --import tsx test/run-e2e-ci.ts --guards",
    "test:e2e:sqlite": "tsx scripts/kill-test-servers.ts && node --env-file=.env.test.sqlite --import tsx test/run-e2e-ci.ts",
    "test:e2e:postgres-kysely": "tsx scripts/kill-test-servers.ts && node --env-file=.env.test.postgres-kysely --import tsx test/run-e2e-ci.ts",
    "test:playwright": "node --env-file=.env.test.sqlite --import tsx test/run-playwright-ci.ts",
    "test:playwright:sqlite": "node --env-file=.env.test.sqlite --import tsx test/run-playwright-ci.ts",
    "test:playwright:postgres-kysely": "node --env-file=.env.test.postgres-kysely --import tsx test/run-playwright-ci.ts",
    "test:e2e:all-backends": "node --env-file=.env.test.sqlite --import tsx test/run-e2e-ci.ts --all && node --env-file=.env.test.postgres-kysely --import tsx test/run-e2e-ci.ts --all",
    "test:e2e:ci": "node --import tsx test/run-e2e-ci.ts --all",
    "test:e2e:ci:filter": "node --import tsx test/run-e2e-ci.ts",
    "lint": "eslint src/ public/ --max-warnings 0",
    "lint:tests": "eslint test/",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "typecheck:sdk": "tsc --noEmit -p tsconfig.sdk.json",
    "check:importmap": "tsx scripts/check-importmap.ts",
    "check:profile-tabs": "tsx scripts/check-profile-tabs.ts",
    "check:config-coverage": "tsx scripts/check-config-coverage.ts --strict",
    "check:config-coverage:report": "tsx scripts/check-config-coverage.ts",
    "check:config-coverage:seed": "tsx scripts/check-config-coverage.ts --seed",
    "check:no-max-tokens": "tsx scripts/check-no-max-tokens.ts",
    "check:openapi": "tsx scripts/check-openapi.ts",
    "check:silent-catch": "tsx scripts/check-silent-catch.ts",
    "check:js-syntax": "node --experimental-vm-modules --import tsx scripts/check-js-syntax.ts",
    "check:ai-disclosure": "tsx scripts/check-ai-disclosure.ts",
    "check:locales": "tsx scripts/check-locales.ts",
    "locale:extract": "tsx scripts/locale-extract.ts",
    "locale:merge": "tsx scripts/locale-merge.ts",
    "screenshot:worker": "tsx scripts/screenshot-worker.ts",
    "generate:types": "openapi-typescript ../openapi.yaml -o src/generated/api-types.ts",
    "db:reset": "node --env-file=.env --import tsx scripts/db-reset.ts",
    "telemetry:stats": "node --env-file=.env --import tsx scripts/telemetry-prune.ts",
    "telemetry:prune": "node --env-file=.env --import tsx scripts/telemetry-prune.ts",
    "consent-audit:stats": "node --env-file=.env --import tsx scripts/consent-audit-prune.ts",
    "consent-audit:prune": "node --env-file=.env --import tsx scripts/consent-audit-prune.ts",
    "versions:stats": "node --env-file=.env --import tsx scripts/archive-stale-versions.ts",
    "versions:archive": "node --env-file=.env --import tsx scripts/archive-stale-versions.ts --apply",
    "seed:examples": "node --import tsx scripts/seed-digital-signage.ts",
    "indexnow": "node --env-file=.env --import tsx scripts/indexnow.ts",
    "audit": "pnpm audit --audit-level=high",
    "audit:fix": "pnpm audit --fix",
    "audit:mcp-tools": "tsx scripts/audit-mcp-tools.ts",
    "audit:mcp-schemas": "tsx scripts/audit-mcp-schemas.ts",
    "eval:mcp-surface": "tsx test/eval-mcp/surface-weight.ts",
    "prepublishOnly": "node -e \"require('fs').copyFileSync('../README.md','README.md')\" && pnpm build",
    "perf:bench": "node --import tsx tools/perf-bench/bench.ts",
    "perf:bench:backends": "node --import tsx tools/perf-bench/bench-backends.ts",
    "sync:viewport": "tsx scripts/embed-viewport.ts",
    "check:viewport": "tsx scripts/embed-viewport.ts --check",
    "check:theme": "tsx tools/theme-contrast.ts",
    "check:route-scopes": "tsx scripts/check-route-scopes.ts --strict",
    "check:denial-coverage": "tsx scripts/check-denial-coverage.ts --strict",
    "check:denial-coverage:report": "tsx scripts/check-denial-coverage.ts",
    "check:denial-coverage:seed": "tsx scripts/check-denial-coverage.ts --seed",
    "check:route-scopes:report": "tsx scripts/check-route-scopes.ts",
    "check:outbound-fetch": "tsx scripts/check-outbound-fetch.ts --strict",
    "check:trusted-keys": "tsx scripts/check-trusted-keys.ts --strict",
    "check:trusted-keys:report": "tsx scripts/check-trusted-keys.ts",
    "check:trusted-keys:seed": "tsx scripts/check-trusted-keys.ts --seed",
    "check:ext-entrypoints": "tsx scripts/check-ext-entrypoints.ts --strict",
    "check:shared-impl": "tsx scripts/check-shared-implementation.ts --strict",
    "check:sse-parity": "tsx scripts/check-sse-parity.ts --strict",
    "check:copied-logic": "tsx scripts/check-copied-logic.ts --strict",
    "check:liaison-surface": "tsx scripts/check-liaison-surface.ts --strict",
    "check:storage-parity": "tsx scripts/check-storage-parity.ts --strict",
    "check:audit-gates": "pnpm check:route-scopes && pnpm check:denial-coverage && pnpm check:outbound-fetch && pnpm check:trusted-keys && pnpm check:storage-parity && pnpm check:ext-entrypoints && pnpm check:shared-impl && pnpm check:sse-parity && pnpm check:copied-logic && pnpm check:liaison-surface"
  },
