# E2E test config — SQLite disk
# Data persists to a temp file, deleted before each run.
# Copy to .env.test.sqlite and fill in your values.

AIMEAT_DB=sqlite
AIMEAT_DB_PATH=test/.test-e2e.db
AIMEAT_PORT=40251
AIMEAT_ADMIN_PASSWORD=test-admin-pw
AIMEAT_LOG_LEVEL=error
AIMEAT_ANONYMOUS_MODE=true
AIMEAT_DEV_MODE=true
AIMEAT_TEST_MODE=true

# Encryption key for tests (AES-256 = 32 bytes = 64 hex chars)
AIMEAT_ENCRYPTION_KEY=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20

# SMTP (optional, needed for email tests)
#AIMEAT_SMTP_HOST="mail.example.com"
#AIMEAT_SMTP_PORT=587
#AIMEAT_SMTP_USER="notifications@example.com"
#AIMEAT_SMTP_PASS="changeme"
#AIMEAT_SMTP_FROM="AIMEAT <notifications@example.com>"
#AIMEAT_SMTP_REJECT_UNAUTHORIZED=false

# High rate limits for test speed
AIMEAT_RL_GLOBAL=10000
AIMEAT_RL_AUTH=1000
AIMEAT_RL_WORK=1000
AIMEAT_RL_MEMORY=1000
AIMEAT_RL_BOARDS=1000
AIMEAT_RL_AUTH_CHALLENGE=10

# Web Bot Auth outbound signing ON in tests so the e2e can verify RFC 9421 signatures end-to-end.
AIMEAT_WEB_BOT_AUTH_SIGN=true

# Low cap so the decision-log prune is reachable in tests
AIMEAT_ORGANISM_DECISION_LOG_CAP=20

# The money rail needs a settleable handler or every money-priced metered call 402s with
# MONEY_SETTLEMENT_UNAVAILABLE. Stripe wants a payment instrument the metered path never sends,
# and x402 wants a real on-chain payment, so tests use the in-process EUR/USD double.
AIMEAT_TEST_MONEY_HANDLER=true

# TARGET-058 Phase 3. The AI Act MARKET-SURVEILLANCE authority — a different regulator from the
# data-protection authority, which is why /v1/ai-transparency has its own pair of fields. The E2E
# reads these back out of process.env rather than hardcoding them, so the suite passes whether or
# not you set them; setting them here is what exercises the populated branch.
AIMEAT_AI_SUPERVISORY_NAME="Liikenne- ja viestintävirasto Traficom"
AIMEAT_AI_SUPERVISORY_URL="https://www.traficom.fi"
