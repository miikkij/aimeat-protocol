# E2E test config — Postgres + Kysely (Phase 5, the Prisma-free backend)
# Requires a running PostgreSQL instance. Update DATABASE_URL for your setup.
# Copy to .env.test.postgres-kysely and fill in your values.
#
# The schema is built by the node's own Kysely migration runner on boot (no prisma db push).
# The E2E runner empties every table except _kysely_migrations between runs.

AIMEAT_DB=postgres-kysely
DATABASE_URL="postgresql://appuser:devpassword123@localhost:5432/aimeat_kysely_e2e?schema=public"
AIMEAT_PORT=40251
AIMEAT_ADMIN_PASSWORD=test-admin-pw
AIMEAT_LOG_LEVEL=error
AIMEAT_ANONYMOUS_MODE=true
AIMEAT_DEV_MODE=true
AIMEAT_TEST_MODE=true
AIMEAT_WELCOME_BONUS=100

# Encryption key for tests (AES-256 = 32 bytes = 64 hex chars)
AIMEAT_ENCRYPTION_KEY=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20

# High rate limits for test speed
AIMEAT_RL_GLOBAL=10000
AIMEAT_RL_AUTH=1000
AIMEAT_RL_WORK=1000
AIMEAT_RL_MEMORY=1000
AIMEAT_RL_BOARDS=1000
AIMEAT_RL_AUTH_CHALLENGE=10

AIMEAT_WEB_BOT_AUTH_SIGN=true

# Low cap so the decision-log prune is reachable in tests
AIMEAT_ORGANISM_DECISION_LOG_CAP=20

# The money rail needs a settleable handler or every money-priced metered call 402s with
# MONEY_SETTLEMENT_UNAVAILABLE. Stripe wants a payment instrument the metered path never sends,
# and x402 wants a real on-chain payment, so tests use the in-process EUR/USD double.
AIMEAT_TEST_MONEY_HANDLER=true
