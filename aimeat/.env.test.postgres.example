# E2E test config — PostgreSQL
# Requires a running PostgreSQL instance. Update DATABASE_URL for your setup.
# Copy to .env.test.postgres and fill in your values.
#
# Quick local Postgres for tests:
#   docker run --rm -e POSTGRES_USER=user -e POSTGRES_PASSWORD=pass \
#     -e POSTGRES_DB=aimeat_e2e -p 5432:5432 postgres:16

AIMEAT_DB=postgresql
DATABASE_URL="postgresql://user:pass@localhost:5432/aimeat_e2e?schema=public"
AIMEAT_PORT=40251
AIMEAT_ADMIN_PASSWORD=test-admin-pw
AIMEAT_LOG_LEVEL=error
AIMEAT_ANONYMOUS_MODE=true
AIMEAT_DEV_MODE=true
AIMEAT_TEST_MODE=true
AIMEAT_WELCOME_BONUS=100

# Encryption key for tests (AES-256 = 32 bytes = 64 hex chars)
AIMEAT_ENCRYPTION_KEY=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20

# SMTP (optional, needed for email tests)
#AIMEAT_SMTP_HOST="mail.example.com"
#AIMEAT_SMTP_PORT=587
#AIMEAT_SMTP_USER="notifications@example.com"
#AIMEAT_SMTP_PASS="changeme"
#AIMEAT_SMTP_FROM="AIMEAT <notifications@example.com>"
#AIMEAT_SMTP_REJECT_UNAUTHORIZED=false

# High rate limits for test speed
AIMEAT_RL_GLOBAL=10000
AIMEAT_RL_AUTH=1000
AIMEAT_RL_WORK=1000
AIMEAT_RL_MEMORY=1000
AIMEAT_RL_BOARDS=1000
AIMEAT_RL_AUTH_CHALLENGE=10
