# ── dify-bridge shim ──
SHIM_PORT=8787
SHIM_PATH=/invoke
# Optional hardening (see design doc §6d):
EXPECTED_NODE_ID=          # e.g. aimeat-local-001-dev — reject other nodes
SHIM_URL_SECRET=           # ?key= guard; ONLY for non-public capabilities
MAX_SKEW_SECONDS=300       # reject stale X-AIMEAT-Timestamp (replay limiting)

# ── Dify target ──
DIFY_MODE=mock             # mock | live   (mock needs no Dify creds)
DIFY_BASE_URL=https://api.dify.ai
DIFY_APP_KEY=              # app-xxxxxxxx (keep secret; live mode only)
DIFY_APP_TYPE=workflow     # workflow | chat
DIFY_QUERY_FIELD=query     # chat mode: which input field holds the user query
DIFY_TIMEOUT_MS=9000       # must stay below AIMEAT's 10s capability ceiling

# ── Used by the helper scripts (register/invoke) ──
AIMEAT_BASE_URL=http://127.0.0.1:40050
AIMEAT_TOKEN=              # owner JWT/PAT to register; any caller JWT/PAT to invoke
WEBHOOK_URL=http://127.0.0.1:8787/invoke
CAP_ID=dify-summarize-doc
CAP_VISIBILITY=public
INPUT={"text":"AIMEAT is a protocol for AI agents."}
