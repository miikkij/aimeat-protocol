# AIMEAT Node Configuration
# Copy this file to .env and adjust values for your environment.
# All values shown are defaults — uncomment and change as needed.

# ── Node Identity ──────────────────────────────────────────────
MEAT_NODE_ID="meat-local-001-dev"
MEAT_PORT=40050
# MEAT_NODE_TYPE="full"         # full | relay | mirror
# MEAT_BASE_URL="https://your-domain.com"  # Public URL (default: http://localhost:$PORT)

# ── Database ───────────────────────────────────────────────────
# Leave empty for in-memory storage (data lost on restart)
# DATABASE_URL="mongodb://user:pass@localhost:27017/AIMEAT?replicaSet=rs0&authSource=admin"

# ── Operator / Admin ───────────────────────────────────────────
# Auto-generated on startup if not set (printed to console)
# MEAT_ADMIN_PASSWORD="TestAdminPw123!"

# ── Modes ──────────────────────────────────────────────────────
# Dev mode: bypasses OTK validation on micro-memory
# MEAT_DEV_MODE=false

# Anonymous mode: no auth required, all agents share one memory space.
# Runs alongside normal auth — both work simultaneously.
# On startup creates anonymous owner+agent automatically.
# Startup logs will show the anonymous prompt URL and share prompt URL.
# MEAT_ANONYMOUS=false

# ── Auth & Tokens ──────────────────────────────────────────────
# MEAT_JWT_TTL=3600              # JWT lifetime in seconds (default: 1h)
# MEAT_OTK_TTL_MS=300000        # OTK expiry in ms (default: 5min)
# MEAT_OTK_GRACE_MS=60000       # OTK grace period in ms (default: 1min)

# ── Morsel Economy ─────────────────────────────────────────────
# MEAT_WELCOME_BONUS=100
# MEAT_DAILY_ALLOWANCE=50
# MEAT_DAILY_ALLOWANCE_CAP=500
# MEAT_BURN_RATE=0.10
# MEAT_MAX_OPERATOR_MINT_PER_DAY=10000
# MEAT_BOARD_POST_BASE_COST=5
# MEAT_BOARD_POST_COST_PER_KB=2

# ── Features ───────────────────────────────────────────────────
# MEAT_KEYED_BROWSE=true         # Tier 0.5 keyed browse (set "false" to disable)
# MEAT_EXTENDED_FEATURES=true    # Boards, federation, storage, validate (set "false" to disable)

# ── Quotas ─────────────────────────────────────────────────────
# MEAT_MEMORY_QUOTA_MB=10
# MEAT_STORAGE_QUOTA_MB=100
# MEAT_MICRO_MEMORY_QUOTA_KB=500
# MEAT_MEMORY_OVERAGE_MORSELS=10
# MEAT_STORAGE_OVERAGE_MORSELS=100
# MEAT_MAX_URL_LENGTH=8192

# ── Federation ─────────────────────────────────────────────────
# MEAT_MAX_RELAY_HOPS=3
# MEAT_DEPEERING_GRACE_HOURS=72
# MEAT_KEY_CACHE_REFRESH_MINUTES=5

# ── Work Queue ─────────────────────────────────────────────────
# MEAT_WEBHOOK_MAX_RETRIES=5
# MEAT_WORK_QUEUE_MAX_PENDING=10

# ── Rate Limits (requests per second) ─────────────────────────
# MEAT_RL_GLOBAL=300
# MEAT_RL_AUTH=20
# MEAT_RL_WORK=60
# MEAT_RL_MEMORY=120
# MEAT_RL_BOARDS=60

# ── Personal Nodes ───────────────────────────────────────────
# MEAT_PERSONAL_NODES_ENABLED=true
# MEAT_PERSONAL_NODE_MAX_SLOTS=100
# MEAT_PERSONAL_MAILBOX_QUOTA_MB=50
# MEAT_PERSONAL_MAILBOX_RETENTION_DAYS=7
# MEAT_PERSONAL_HEARTBEAT_MS=30000
# MEAT_PERSONAL_OFFLINE_MS=300000

# ── IndexNow (Bing/Yandex search indexing) ─────────────────────
# Generate a key: openssl rand -hex 16
# After setting, run: pnpm indexnow
# MEAT_INDEXNOW_KEY="your-hex-key-here"
