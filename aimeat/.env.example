# AIMEAT Node Configuration
# Copy this file to .env and adjust values for your environment.

# Node identity
MEAT_NODE_ID="meat-local-001-dev"

# HTTP port
MEAT_PORT=40151

# MongoDB connection (leave empty for in-memory storage)
DATABASE_URL="mongodb://dbuser:dbpassword@localhost:27017/AIMEAT?replicaSet=myReplicaSet&authSource=admin"

# Operator admin password (required for /v1/admin/* endpoints)
MEAT_ADMIN_PASSWORD="TestAdminPw123!"

# JWT token lifetime in seconds (default: 1 hour)
MEAT_JWT_TTL=3600

# Morsel economy settings
MEAT_WELCOME_BONUS=100
MEAT_DAILY_ALLOWANCE=50
MEAT_DAILY_ALLOWANCE_CAP=500
MEAT_BURN_RATE=0.10

# Enable keyed browse (Tier 0.5) — set to "false" to disable
MEAT_KEYED_BROWSE=true
