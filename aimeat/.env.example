# AIMEAT Node Configuration
# Copy this file to .env and adjust values for your environment.
# All values shown are defaults — uncomment and change as needed.

# ── Node Identity ──────────────────────────────────────────────
AIMEAT_NODE_ID="aimeat-local-001-dev"
AIMEAT_PORT=40050
# AIMEAT_NODE_TYPE="full"         # full | relay | mirror
# AIMEAT_BASE_URL="https://your-domain.com"  # Public URL (default: http://localhost:$PORT)

# ── App Origin Isolation (H-2) ─────────────────────────────────
# User-published apps run on a dedicated origin so they can never reach the
# authenticated SPA's session. Requires DNS + a *.apps.<host> TLS cert + an nginx
# server_name block (see docs/internal/app-origin-deployment.md). Keep DISABLED
# until that infra is live — enabling it without DNS/cert would 301 apps to a host
# that does not resolve.
# AIMEAT_APP_HOST="apps.your-domain.com"   # default: apps.<AIMEAT_BASE_URL host>, empty for localhost/IP
# AIMEAT_APP_ORIGIN_ENABLED=false          # true → apex inline app HTML 301s to the app origin

# ── Portfolio Origin ──────────────────────────────────────────
# Published portfolios served standalone at <username>.portfolio.<host> (same
# isolation model + infra as the app origin: wildcard DNS + TLS + nginx block).
# AIMEAT_PORTFOLIO_HOST="portfolio.your-domain.com"  # default: portfolio.<AIMEAT_BASE_URL host>, empty for localhost/IP
# AIMEAT_PORTFOLIO_ORIGIN_ENABLED=false              # true → standalone portfolio URLs advertised + served

# ── Company Origin (company-in-a-box) ─────────────────────────
# A registered company's front page served at <slug>.co.<host> — the co family is to
# companies what the apps family is to apps (same isolation model + infra: wildcard DNS +
# TLS + an nginx block that sets X-Co-Origin and X-Subdomain).
# AIMEAT_CO_HOST="co.your-domain.com"      # default: co.<AIMEAT_BASE_URL host>, empty for localhost/IP
# AIMEAT_CO_ORIGIN_ENABLED=false           # true → company addresses advertised + served

# ── Storage Backend ───────────────────────────────────────────
# Choose storage: memory (default, data lost on restart), sqlite (file-based, zero-config),
# or postgres-kysely (production PostgreSQL; schema migrates on boot).
# `postgres` / `postgresql` are accepted as aliases for postgres-kysely.
# AIMEAT_STORAGE="memory"

# SQLite — file path for the database (auto-created on first run)
# AIMEAT_SQLITE_PATH="./data/aimeat.db"

# PostgreSQL — required when AIMEAT_STORAGE=postgres-kysely
# DATABASE_URL="postgresql://user:pass@localhost:5432/aimeat?schema=public"

# ── Operator / Admin ───────────────────────────────────────────
# Auto-generated on startup if not set (printed to console)
# AIMEAT_ADMIN_PASSWORD="TestAdminPw123!"

# ── Diagnostics ────────────────────────────────────────────────
# Per-request storage profiler. When =true, storage calls are timed+counted for any request that opts
# in with `?trace=1` or the `x-aimeat-trace: 1` header; the summary (query count, DB ms, wall ms,
# hottest methods) is in the `X-Aimeat-Perf` response header and the log. Safe-off default; leave unset
# in production (a Proxy wraps every storage call when on). See services/perf-trace.ts.
# AIMEAT_PERF_TRACE=true

# ── Modes ──────────────────────────────────────────────────────
# Dev mode: allows localhost webhooks, re-registration resets password only (preserves agents/data)
# AIMEAT_DEV_MODE=false

# Test mode: re-registration wipes account entirely (E2E test isolation). Never use in production.
# AIMEAT_TEST_MODE=false

# Anonymous mode: no auth required, all agents share one memory space.
# Runs alongside normal auth — both work simultaneously.
# On startup creates anonymous owner+agent automatically.
# Startup logs will show the anonymous prompt URL and share prompt URL.
# AIMEAT_ANONYMOUS=false
# AIMEAT_SCREENSHOT_AUTO=false             # true → node auto-generates app thumbnails (needs a headless browser; uses system Edge/Chrome)
# AIMEAT_SCREENSHOT_INTERVAL_MIN=15        # minutes between auto-screenshot scans
# CORS: comma-separated list of allowed origins, or * for all (default: *)
# By architecture, AIMEAT accepts requests from any origin -- the platform
# is Bearer-token-only (OAuth 2.1), no cookies, so CORS is not the protection
# layer. Apps published on the network attach from arbitrary browser origins.
# Set this only if you specifically want to restrict which origins can attach.
# AIMEAT_CORS_ALLOWED_ORIGINS=*
# AIMEAT_CORS_ALLOWED_ORIGINS=https://portal.aimeat.fi,https://my-app.example.com

# ── Operator info (REQUIRED for /v1/privacy page) ──────────────
# These fields identify the operator of THIS node as the GDPR data controller.
# Every AIMEAT node must fill them in -- otherwise /v1/privacy returns 503
# "Privacy policy not configured" so the operator is forced to address it
# before going public. Do NOT ship a deployment that names someone else.
#
# Privacy policy template substitution: these env vars feed {{placeholder}}
# tokens in aimeat/public/privacy.html and privacy.fi.html at render time.
#
# REQUIRED:
# AIMEAT_OPERATOR_NAME="Your Name or Company Ltd"
# AIMEAT_OPERATOR_ADDRESS="Street, Postcode City, Country"
# AIMEAT_OPERATOR_COUNTRY="Finland"
# AIMEAT_OPERATOR_EMAIL="privacy@example.com"
# AIMEAT_OPERATOR_HOSTING_NAME="Scaleway SAS"
# AIMEAT_OPERATOR_HOSTING_LOCATION="France (EU/EEA)"
# AIMEAT_OPERATOR_SUPERVISORY_NAME="Office of the Data Protection Ombudsman"
# AIMEAT_OPERATOR_SUPERVISORY_URL="https://tietosuoja.fi"
# AIMEAT_OPERATOR_EFFECTIVE_DATE="2026-05-29"
#
# OPTIONAL:
# AIMEAT_OPERATOR_TYPE="natural_person"   # natural_person | company | organisation | association
# AIMEAT_OPERATOR_BUSINESS_ID=""          # Y-tunnus / VAT id / company number. Empty for a natural person;
#                                         # set it and this node identifies as that legal entity on invoices,
#                                         # contracts and ODPS listings. This is what makes it a company node.
# AIMEAT_OPERATOR_SECURITY_EMAIL=""       # defaults to AIMEAT_OPERATOR_EMAIL
# AIMEAT_OPERATOR_HOSTING_URL=""          # hyperlink to your hosting provider
# AIMEAT_OPERATOR_POLICY_VERSION="1.0"

# ── Public-page links (all optional) ───────────────────────────
# The marketing pages (/v1/portal, /v1/how-it-works, /v1/business, /v1/help) can point at
# apps and contacts that belong to WHOEVER RUNS THIS NODE. They are not protocol features.
#
# Empty is the default and it is a valid, complete configuration: an unset value hides its
# link, its nav item or the whole section. A node that sets none of these still gets a
# coherent site, and it never advertises another operator's apps or phone number.
#
# aimeat.io fills these in from its own deployment environment. Set the ones you actually
# have, point them at your own apps, and leave the rest empty.
#
# AIMEAT_SITE_LEARN_URL=""              # hands-on academy / showroom app → adds the "Learn" nav item
# AIMEAT_SITE_EXCHANGE_URL=""           # capability marketplace app → adds the "EXCHANGE" nav item
# AIMEAT_SITE_ASSESSMENT_URL=""         # free AI current-state assessment (business-page entry point)
# AIMEAT_SITE_ROADMAP_URL=""            # public roadmap + portfolio surface
# AIMEAT_SITE_PAPER_URL=""              # agent-written publication ("work happens without you" proof)
# AIMEAT_SITE_CRM_URL=""                # CRM app
# AIMEAT_SITE_RADAR_URL=""              # company-intelligence / mention radar app
# AIMEAT_SITE_BRIEFING_URL=""           # morning briefing board app
# AIMEAT_SITE_API_ACCELERATOR_URL=""    # make-an-existing-API-agent-native app
# AIMEAT_SITE_PLAYBOOKS_URL=""          # playbook app (the repeatable change package)
# AIMEAT_SITE_SHOWCASE_URL=""           # an external site running on AIMEAT, shown as third-party proof
#
# People printed on the public pages, as a JSON array, ORDERED BY WHO SHOULD FIELD THE FIRST
# MESSAGE — every "book a demo" button mails the first entry. `role`, `phone` and `linkedin`
# are optional; an entry without an email is dropped. Configure nobody and no contact card is
# rendered at all.
# AIMEAT_SITE_CONTACTS='[{"name":"Firstname Lastname","role":"CEO","email":"ceo@example.com","phone":"+358 40 1234567","linkedin":"https://www.linkedin.com/in/example/"},{"name":"Second Person","role":"CTO","email":"cto@example.com","phone":"","linkedin":""}]'
#
# Single-contact fallback, used only when AIMEAT_SITE_CONTACTS is unset or unparseable.
# The email falls back again to AIMEAT_OPERATOR_EMAIL.
# AIMEAT_SITE_CONTACT_NAME=""
# AIMEAT_SITE_CONTACT_ROLE=""
# AIMEAT_SITE_CONTACT_EMAIL=""
# AIMEAT_SITE_CONTACT_PHONE=""
# AIMEAT_SITE_CONTACT_LINKEDIN=""

# ── Security Limits ────────────────────────────────────────────
# AIMEAT_REGISTRATION_MODE=open               # Who may get a NEW account: open (default) | oauth | invite | closed.
#                                             # oauth = the password doors (API/web registration, self-service
#                                             # invite request) refuse; a first sign-in through a configured
#                                             # identity provider creates the account, as does an invitation.
#                                             # The organisation-node setting: pair it with the Entra tenant
#                                             # allowlist below and only those orgs' people can get in.
#                                             # invite = the direct doors (API/web registration, OAuth first
#                                             # sign-in, self-service invite request) refuse; member-minted
#                                             # invitations still create accounts. closed = no new accounts
#                                             # at all. Existing accounts always sign in. A private/fleet
#                                             # node sets closed; the flag is enforced in the node, so a
#                                             # proxy deny-list is not the mechanism.
# AIMEAT_LOGIN_RATE_LIMIT_MAX=15              # Max login attempts per window (default: 15)
# AIMEAT_LOGIN_RATE_LIMIT_WINDOW_MS=60000     # Login rate limit window in ms (default: 60s)
# AIMEAT_REGISTRATION_RATE_LIMIT_MAX=5        # Max registrations per window (default: 5)
# AIMEAT_REGISTRATION_RATE_LIMIT_WINDOW_MS=60000
# AIMEAT_ADMIN_AUTH_RATE_LIMIT_MAX=5          # Max admin auth attempts per window (default: 5)
# AIMEAT_ADMIN_AUTH_RATE_LIMIT_WINDOW_MS=60000
# AIMEAT_PASSWORD_LOCKOUT_ATTEMPTS=5          # Failed attempts before lockout (default: 5)
# AIMEAT_PASSWORD_LOCKOUT_MINUTES=15          # Lockout duration in minutes (default: 15)
# AIMEAT_JSON_BODY_LIMIT_MB=5                 # Default JSON body limit (default: 5MB)
# AIMEAT_JSON_BODY_LIMIT_LARGE_MB=15          # Large body limit for apps/extensions (default: 15MB)
# AIMEAT_EXT_MAX_DEBIT=100                    # Max morsels per extension wallet.consume() call
# AIMEAT_EXT_MAX_PAY_MORSELS=10000            # Ceiling on commercial.payMorsels in a manifest
# AIMEAT_FEDERATION_AUTH_POLICY=disabled       # disabled | all_peers | specific_peers
# AIMEAT_FEDERATION_DEFAULT_SCOPES=memory:read,catalogue:read

# ── Security Posture (localhost-flexible → public-strict) ──────
# AIMEAT runs the SAME code wide-open on localhost AND hardened on the public internet.
# Security is DRIVEN BY CONFIG, never a code fork. The profile sets safe DEFAULTS for the
# knobs below; any explicit AIMEAT_* var always overrides it. Full rationale + the ten
# security invariants: docs/coding-guidelines/security-development-dna.md
#
# AIMEAT_SECURITY_PROFILE — local | public
#   The master switch. Default: `local` when AIMEAT_BASE_URL is http://localhost /
#   127.0.0.1 / an RFC1918 host, OR AIMEAT_NODE_TYPE=personal; otherwise `public`.
#   Set it explicitly on a real deployment. `public` flips the two egress knobs below to
#   their strict values and arms the startup self-check.
# AIMEAT_SECURITY_PROFILE=public
#
# AIMEAT_ALLOW_PRIVATE_EGRESS — may SERVER-SIDE fetches target LOOPBACK (127.0.0.1 / ::1 / localhost)?
#   Governs every outbound fetch whose URL is user/owner/agent/peer-influenced: the AI-provider
#   baseUrl, agent/board webhooks, extension ctx.fetch, federation download URLs.
#   local  default: true  — so the node can reach a LOCAL model server (Ollama / LM Studio at
#                           http://127.0.0.1:11434 etc.). This is why localhost stays flexible.
#   public default: false — blocks loopback SSRF (localhost-bound services). NOTE: RFC1918
#                           (10./172.16./192.168.*), link-local + cloud-metadata (169.254.169.254)
#                           are ALWAYS blocked server-side regardless of this flag. Redirects are
#                           re-validated per hop. (AIMEAT_DEV_MODE=true is a back-compat alias.)
# AIMEAT_ALLOW_PRIVATE_EGRESS=false
#
# AIMEAT_AI_PROVIDER_ALLOWLIST — comma-separated HOST allowlist an AI `baseUrl` may point at.
#   Empty = any host (local dev / self-hosted models). On a public multi-tenant node, restrict
#   WHERE a decrypted AI key may be sent so a poisoned baseUrl can't exfiltrate it.
#   Example: openrouter.ai,api.openai.com,api.anthropic.com,api.groq.com
# AIMEAT_AI_PROVIDER_ALLOWLIST=""
#
# ── AI transparency: provenance records (EU AI Act Article 50) ──
#
# AIMEAT_AI_PROVENANCE — mint and serve a provenance record for content this node generates:
#   which model, which principal, when, the SHA-256 of the exact bytes, and how much a person was
#   involved. Default ON, and the safe value on a public node is ON — it is what makes "who made
#   this?" answerable later, and a node that generates and publishes owes the marking whether or
#   not it kept a record. Setting it false is a local dev convenience, not a compliance option.
#   The public detection endpoint GET /v1/provenance/by-hash/:sha256 is unauthenticated for
#   PUBLIC content by design (the Code of Practice's detection access point) and rate-limited.
# AIMEAT_AI_PROVENANCE=true
#
# AIMEAT_AI_PROVENANCE_DETAIL — full | minimal. What a PUBLIC surface SERVES; it never reduces
#   what is stored, and the owner always sees the whole record. `minimal` serves only the four
#   required fields (spec, level, humanInvolvement, generatedAt) plus the disclosure block —
#   useful when a pipeline name or a source list would reveal something commercial. The Code of
#   Practice pushes both ways here: Measure 1.3 encourages richer provenance metadata, while
#   Sub-measure 1.1.1 warns against putting privacy- or business-sensitive information in it.
# AIMEAT_AI_PROVENANCE_DETAIL=full
#
# AIMEAT_AI_LABEL_PUBLIC — strict | light | off. How eagerly a VISIBLE label is shown to a person.
#   Presentation only: the provenance record, the AI-Disclosure header and the machine planes are
#   unaffected by this setting.
#     strict (default) — also label what Article 50 exempts: a person held editorial control, or the
#                        publisher declared the subject matter is not of public interest. The record's
#                        disclosure reason then reads `policy`. Under-labelling is the violation;
#                        over-labelling costs an icon.
#     light            — label exactly what Article 50 requires and nothing more.
#     off              — show no visible label. LOCAL DEVELOPMENT ONLY. A node whose resolved
#                        security profile is `public` REFUSES this and runs `strict` instead, and
#                        says so in the startup posture warnings.
# AIMEAT_AI_LABEL_PUBLIC=strict
#
# AIMEAT_AI_SUPERVISORY_NAME / _URL — the AI Act MARKET-SURVEILLANCE authority for this node, named
#   in GET /v1/ai-transparency. This is NOT the data-protection authority in
#   AIMEAT_OPERATOR_SUPERVISORY_NAME above; naming that one here would put a false statement into a
#   compliance artefact. Which authority applies follows from where the operator is established, so
#   there is no safe default to ship: in Finland it is Traficom, elsewhere it is somebody else.
#   Left empty, the transparency statement reports the authority as unstated rather than guessing.
# AIMEAT_AI_SUPERVISORY_NAME="Liikenne- ja viestintävirasto Traficom"
# AIMEAT_AI_SUPERVISORY_URL="https://www.traficom.fi"
#
# AIMEAT_AI_COP_SECTIONS / _SIGNED_ON — which sections of the EU Code of Practice on Transparency of
#   AI-generated Content YOUR ORGANISATION has signed, and when. Empty is the default and the only
#   value that ships, because the signature belongs to the operator and not to this software: a
#   value written into the source would make every node running it claim somebody else's signature,
#   in the one document a regulator reads first. Set it only after the AI Office has confirmed your
#   signature, and set only the sections you actually signed — GET /v1/ai-transparency then reports
#   `code_of_practice.signatory: true` with those sections, the date, and the sections you did NOT
#   sign together with the reason. Leave it empty and the statement says you are not a signatory.
#   Section 1 is the provider commitment (machine-readable marking of model output), Section 2 the
#   deployer commitment (labelling deep fakes and AI-generated or manipulated published text).
#   Note: using the EU AI Office label icons says nothing about being a signatory, and this node
#   never presents it as if it did.
# AIMEAT_AI_COP_SECTIONS="2"
# AIMEAT_AI_COP_SIGNED_ON="2026-08-01"
#
# Startup self-check: when the resolved profile is `public`, the node warns loudly (or refuses
# to start) on an unsafe combination — AIMEAT_ANONYMOUS=true, AIMEAT_ALLOW_PRIVATE_EGRESS=true,
# AIMEAT_FEDERATION_OPEN_JOIN=true, missing AIMEAT_ENCRYPTION_KEY, AIMEAT_CORS_ALLOWED_ORIGINS=*,
# or AIMEAT_STATS_ACCESS=public. Being insecure on the internet must be a conscious override.
#
# ── Reserved-key write guard (NOT a knob — always-on code invariant) ──
# A role-'app' token (H-2 app grant) has memory:write over the OWNER's namespace. It must NOT
# be able to write keys the SERVER reads and trusts for behavior, or a granted app could redirect
# the owner's AI key, reset their spend cap, or force a public directory listing. Denylisted
# prefixes for non-owner-session principals on POST/PUT /v1/memory (mirrors the ecosystem path's
# ecoMayWriteKey — see DNA invariant #2):
#   openrouter.*   → AI provider config incl. the baseUrl the decrypted key is sent to
#   ai-usage.*     → the daily AI-spend ledger that enforces the budget cap
#   profile.*      → public directory-listing flag + matchmaking inputs
# (Enforcement of this guard and the three posture knobs above lands in config.ts + the memory
#  write path together with the security fixes; documented here as the config/security surface.)

# ── Auth & Tokens ──────────────────────────────────────────────
# AIMEAT_JWT_TTL=3600              # Legacy / agent JWT lifetime in seconds (default: 1h)
# Owner sessions: short access token + rotating httpOnly refresh cookie (no key re-signing).
# AIMEAT_ACCESS_TTL=900            # Owner access-token (JWT) lifetime in seconds (default: 15min)
# AIMEAT_REFRESH_IDLE_DAYS=30      # Owner refresh-cookie idle window in days (default: 30)
# AIMEAT_REFRESH_ABSOLUTE_DAYS=90  # Owner refresh-cookie hard cap in days, never extended (default: 90)
# AIMEAT_REFRESH_GRACE_MS=60000    # Refresh-rotation grace window in ms for concurrency (default: 60s)
# AIMEAT_OTK_TTL_MS=300000        # OTK expiry in ms (default: 5min)
# AIMEAT_OTK_GRACE_MS=60000       # OTK grace period in ms (default: 1min)

# ── Morsel Economy ─────────────────────────────────────────────
# AIMEAT_WELCOME_BONUS=100
# AIMEAT_DAILY_ALLOWANCE=50
# AIMEAT_DAILY_ALLOWANCE_CAP=500
# AIMEAT_BURN_RATE=0.10
# AIMEAT_MAX_OPERATOR_MINT_PER_DAY=10000
# AIMEAT_BOARD_POST_BASE_COST=5
# AIMEAT_BOARD_POST_COST_PER_KB=2

# ── Features ───────────────────────────────────────────────────
# AIMEAT_KEYED_BROWSE=true         # Tier 0.5 keyed browse (set "false" to disable)
# AIMEAT_EXTENDED_FEATURES=true    # Boards, federation, storage, validate (set "false" to disable)

# ── Settings this node's HOST decides, and its operator cannot ─
# For a node one party runs on behalf of another: a hosting provider, a university running one node
# per department, a company running one per team. The paths listed here become readable and
# not writable for the life of the process. The operator still SEES the value on GET
# /v1/admin/config, marked as sealed; PUT, DELETE, the Consul import and `aimeat config import`
# all refuse it, and a value already persisted in this node's own database is ignored at boot.
#
# The VALUES still come from the ordinary AIMEAT_* variables below. This names paths, not values.
# Empty (the default) is the right value for every self-hosted node, where the operator legitimately
# owns all of these settings and nothing here changes. An unknown path refuses the boot, on purpose:
# a node that starts up looking sealed and is not would report nothing.
# AIMEAT_SEALED_CONFIG_KEYS=quota.memory_mb,quota.storage_mb,rate_limits.global,metrics.enabled

# ── Quotas ─────────────────────────────────────────────────────
# AIMEAT_MEMORY_QUOTA_MB=10
# AIMEAT_MEMORY_MAX_VALUE_SIZE_KB=1024
# AIMEAT_MEMORY_MAX_KEYS=1000
# Max retained gate-audit (meta.decisions.*) entries per organism; oldest pruned on write. 0 = unlimited.
# AIMEAT_ORGANISM_DECISION_LOG_CAP=500
# Max retained .version.N history snapshots per workspace record; older ones are pruned on publish.
# A manifest objectType's `maxVersions` overrides this per space; append-only (create_only) spaces
# are NEVER pruned. 0 = keep all history (unbounded — the pre-retention behaviour).
# AIMEAT_WS_MAX_VERSIONS=20
# AIMEAT_STORAGE_QUOTA_MB=100
# AIMEAT_STORAGE_MAX_FILE_SIZE_MB=10
# AIMEAT_STORAGE_MAX_CHUNKED_FILE_SIZE_GB=5
# How many on-demand app screenshots one owner may ask for per hour (POST .../screenshot/capture,
# and the aimeat_app_screenshot tool). Rendering is the most expensive thing this node does per
# request, so this is a throttle rather than a preference.
# AIMEAT_SCREENSHOT_ONDEMAND_PER_HOUR=20
# ── The chat agent (a `goose acp` child process, ACP over stdio) ──
# Empty (the default) disables the chat entirely, which is what every node does until an operator
# installs goose. The node spawns it, speaks ACP over its stdin/stdout, and stops it on shutdown.
#
# Stdio rather than `goose serve` over HTTP, and that was measured rather than preferred: the HTTP
# transport accepts requests and answers them, but never delivers a session/update notification, so
# every turn is silent. The same prompt over stdio answers in seconds. Stdio also needs no port, no
# shared secret and no loopback surface to protect.
# How many chat conversations stay open before the oldest rolls into a per-month archive record.
# A memory namespace holds 1000 keys, and one key per conversation forever would spend them.
# AIMEAT_CHAT_MAX_LIVE_THREADS=50
# AIMEAT_GOOSE_BIN=goose
# Its own config and session store, away from any human's goose profile on the same machine.
# AIMEAT_GOOSE_PATH_ROOT=
# The provider key the agent calls with. Every chat turn on this node is spent from it: the agent is
# one shared process with one process-wide key, so an individual's own OpenRouter key and the
# per-person allowance below do NOT apply to the chat. They apply to /v1/ai/* and /v1/llm. The chat
# page says which of the two paid, and it says this one until the agent's provider is pointed at
# this node's /v1/llm proxy.
# AIMEAT_GOOSE_PROVIDER_API_KEY=
# Which provider and model the agent runs on, handed to the child as GOOSE_PROVIDER and GOOSE_MODEL.
# Empty leaves goose's own configuration alone. Setting the model here rather than there also lets
# the node NAME the model that answered: ACP reports a stop reason and a token count and no model.
# AIMEAT_GOOSE_PROVIDER=openrouter
# AIMEAT_GOOSE_MODEL=
# ── This node's own AI key, and what one person may spend of it ──
# Empty (the default) means the node pays for nothing and everyone brings their own key, which is
# how every node behaved before this existed. Set it and a person who has not brought a key can
# still do something on the day they arrive.
#
# The key is SHARED by everyone here, so the node meters each person itself rather than handing out
# provider access: that is the shape OpenRouter's terms allow. Someone who wants unmetered use
# brings their own key, which bypasses the allowance entirely and is the recommended path.
# AIMEAT_OPENROUTER_INSTANCE_KEY=
# Free starting allowance in USD, applied once per person. 0 grants nothing.
# AIMEAT_CHAT_FREE_ALLOWANCE_USD=0
# Model used when someone on the node's key has spent their allowance. Empty refuses instead of
# degrading. A free model is a worse answer, not a wrong one, as long as the person is told — and
# they are: the response says it was degraded.
# AIMEAT_MODEL_FREE_FALLBACK=openrouter/free
# ── Instance model defaults, one per role ──
# Read only when the OWNER has not chosen a model of their own: owner setting, then this, then a
# refusal that names what to set. Empty (the default) means the node states no preference and every
# role resolves exactly as it did before these existed.
#
# These belong with an instance API key rather than beside it. A key alone does not let a new person
# speak, read an image or make one, because every model role is an owner-level setting and an unset
# one is an error rather than a fallback. Speech is the sharpest case: without AIMEAT_MODEL_DEFAULT_STT
# a brand-new account cannot use the microphone at all until it finds a settings page it has no
# reason to know about.
# AIMEAT_MODEL_DEFAULT_CHAT=
# AIMEAT_MODEL_DEFAULT_REASONING=
# AIMEAT_MODEL_DEFAULT_EXECUTION=
# AIMEAT_MODEL_DEFAULT_VISION=
# AIMEAT_MODEL_DEFAULT_STT=
# AIMEAT_MODEL_DEFAULT_IMAGE=
# The image model is used by POST /v1/ai/image and aimeat_image_generate. Without one, on the
# owner or here, that route refuses by name rather than handing the request to a chat model.
# ISO-639-1 hint for speech-to-text. Empty lets the model detect it, which is what mixed-language
# speech wants, so set this only where the node knows its audio is one language.
# AIMEAT_STT_LANGUAGE_DEFAULT=
# ── Speech-to-text (POST /v1/ai/transcribe, voice messages) ──
# Largest audio file accepted for transcription. 25 MB is the provider-side multipart ceiling, so
# raising this past it turns a clear local refusal into an opaque upstream one.
# AIMEAT_STT_MAX_MB=25
# Duration guideline in seconds. Checked after the call (only the response knows the duration) and
# logged; a transcription the owner has already paid for is never withheld. 0 disables the warning.
# AIMEAT_STT_MAX_SECONDS=600
# Hard cap on one browser voice-message recording, in seconds. Served to the UI so the recorder stops
# at this node's number. Raise it for long-form dictation; every second still costs the owner money.
# AIMEAT_VOICE_MSG_MAX_SECONDS=300
# AIMEAT_MICRO_MEMORY_QUOTA_KB=500
# AIMEAT_MICRO_MEMORY_MAX_SETS=50
# AIMEAT_MICRO_MEMORY_MAX_KEYS_PER_SET=100
# AIMEAT_MICRO_MEMORY_MAX_VALUE_SIZE=16384
# AIMEAT_MAX_ACTIONS_PER_AGENT=20
# AIMEAT_MIN_TRUST_PAID_ACTIONS=10
# AIMEAT_APP_MAX_SIZE_MB=5
# Publish-time asset check: ask this node over loopback whether the script/stylesheet URLs a
# published app loads actually resolve. A 404 refuses the publish, which is what stops an app
# whose <script src> is wrong from going live broken. Safe everywhere (the request only ever goes
# to 127.0.0.1 on this node's own port); set to false only if the node cannot reach itself.
# AIMEAT_APP_ASSET_PROBE=true
# AIMEAT_AGENT_PORTING_FEE=50
# AIMEAT_MEMORY_OVERAGE_MORSELS=10
# AIMEAT_STORAGE_OVERAGE_MORSELS=100
# AIMEAT_MAX_URL_LENGTH=8192

# ── Federation ─────────────────────────────────────────────────
# AIMEAT_FEDERATION_ROLE="standalone"  # operator | contributor | standalone
# AIMEAT_GENESIS_URL=""                # Genesis node URL (for contributor role)
# AIMEAT_MAX_RELAY_HOPS=3
# AIMEAT_DEPEERING_GRACE_HOURS=72
# AIMEAT_KEY_CACHE_REFRESH_MINUTES=5

# ── Work Queue ─────────────────────────────────────────────────
# AIMEAT_WEBHOOK_MAX_RETRIES=5
# AIMEAT_WORK_QUEUE_MAX_PENDING=10

# ── Rate Limits (requests per second) ─────────────────────────
# Global default — all endpoints inherit this unless overridden
# AIMEAT_RL_GLOBAL=300
#
# Per-tier limits (applied to route groups)
# AIMEAT_RL_AUTH=20
# AIMEAT_RL_WORK=60
# AIMEAT_RL_MEMORY=120
# AIMEAT_RL_BOARDS=60
#
# Per-endpoint overrides (optional — defaults to global if not set)
# AIMEAT_RL_OWNERS=300
# AIMEAT_RL_GHII=300
# AIMEAT_RL_FLAGS=300
# AIMEAT_RL_APPEALS=300
# AIMEAT_RL_ADMIN_SETUP=300
# AIMEAT_RL_FEDERATION=300
# AIMEAT_RL_CATALOGUE=300
# AIMEAT_RL_AUTH_CHALLENGE=300

# ── The agent door: POST /v1/registration-invites ──
# Requests per HOUR per IP (every other AIMEAT_RL_* value is per second). This endpoint is open by
# design — an AI calling it has no identity yet — and it sends email to an address it was handed,
# so the thing being protected is a stranger's inbox rather than the node's CPU.
#
# The safe PUBLIC default is 5/hour and needs no override: a person registers once. Raise it only
# where something legitimately makes more calls than a human would (the E2E suites set 1000).
# A second, independent cap lives in the service: one LIVE invitation per address at a time,
# which holds even against a caller rotating IPs.
# AIMEAT_RL_REGISTRATION_INVITES=5

# ── The home's four rooms ──
# Room 3 (monetising). OFF by default, and it stays off until someone has actually walked into it
# on THIS node. "The app is published here" is not the same as "a person who clicks the card finds
# something": an app served from the isolated app origin has no session for a cold arrival, so it
# can render a permanent loading state while every automated check reports it present. A door into
# an empty room breaks the product's own rule about empty states at the exact moment the person has
# finally got interested, so this is a judgement an operator makes once, not an inference.
# AIMEAT_HOME_ROOM_MONETISE=false

# One friendly email to somebody nobody has been seen on for a fortnight, carrying a prompt they
# can run straight from the message. OFF by default, and the default is the point: this is
# unsolicited mail to real people, so turning it on is a decision somebody makes rather than
# something a deploy does. Needs the email service enabled; honours the notification setting the
# profile already writes, and never mails the same person twice within 60 days.
# AIMEAT_INACTIVITY_NUDGE=false

# ── Personal Nodes ───────────────────────────────────────────
# AIMEAT_PERSONAL_NODES_ENABLED=true
# AIMEAT_PERSONAL_NODE_MAX_SLOTS=100
# AIMEAT_PERSONAL_MAILBOX_QUOTA_MB=50
# AIMEAT_PERSONAL_MAILBOX_RETENTION_DAYS=7
# AIMEAT_PERSONAL_HEARTBEAT_MS=30000
# AIMEAT_PERSONAL_OFFLINE_MS=300000

# ── Connector Forward Tunnel ─────────────────────────────────
# One persistent WS per agent identity at /v1/connect/tunnel: carries forward
# API calls (agent→server) + realtime reverse delivery (server→agent push).
# OPT-IN — off by default until the Node connector client (Phase 3) ships.
# AIMEAT_CONNECT_TUNNEL_ENABLED=false
# AIMEAT_CONNECT_TUNNEL_HEARTBEAT_MS=30000
# AIMEAT_CONNECT_TUNNEL_OFFLINE_MS=90000
# AIMEAT_CONNECT_TUNNEL_REQUEST_TIMEOUT_MS=30000

# ── Email / SMTP (Phase 1.1) ────────────────────────────────
# AIMEAT_SMTP_HOST="smtp.example.com"
# AIMEAT_SMTP_PORT=587
# AIMEAT_SMTP_USER="noreply@example.com"
# AIMEAT_SMTP_PASS="secret"
# AIMEAT_SMTP_FROM="AIMEAT <noreply@example.com>"
# AIMEAT_SMTP_SECURE=false
# AIMEAT_SMTP_REJECT_UNAUTHORIZED=false  # Set to false for STARTTLS with self-signed certs
# AIMEAT_EMAIL_CONFIRMATION_REQUIRED=false

# ── Outbound door (company-in-a-box) ─────────────────────────
# Max sent outbound messages per owner per rolling 24 h. Safe public default; raise on a
# private/local node if a legitimate campaign needs it.
# AIMEAT_OUTBOUND_DAILY_LIMIT=200

# ── Door defences: what happens when somebody is refused ──────────────────────
#
# THE REFUSAL LOG. One JSON line per 401 and 403: when, which door, from where, with what kind of
# credential, and a truncated digest of it so the same dead token is recognisable across lines
# without ever being written down. The credential itself is never recorded, in any form.
# Read it with:  grep '"status":401' data/auth-failures.log | tail -50
# Count the busiest addresses:
#   node -e "const l=require('fs').readFileSync('data/auth-failures.log','utf8').trim().split('
').map(JSON.parse);const c={};for(const r of l)c[r.ip]=(c[r.ip]||0)+1;console.table(Object.entries(c).sort((a,b)=>b[1]-a[1]).slice(0,20))"
# Empty the path to switch it off. It rotates at the byte ceiling and keeps one older generation,
# because the volume through it is chosen by whoever is attacking rather than by this node.
# AIMEAT_AUTH_LOG_PATH=./data/auth-failures.log
# AIMEAT_AUTH_LOG_MAX_BYTES=5242880
#
# THE CREDENTIAL-DOOR TARPIT. A per-address delay in front of the password, code and signature
# doors that grows with each refusal, so guessing costs the guesser time and costs everyone else
# nothing. Two refusals are free (a mistyped password is not punished), each one after that adds
# four seconds to a ceiling of thirty, and past twelve the door stops holding the connection and
# answers 429 with a Retry-After. A penalty decays after fifteen quiet minutes: nobody is locked
# out of their own account because an attacker shares their office address.
# AIMEAT_LOGIN_TARPIT_ENABLED=true
# AIMEAT_LOGIN_TARPIT_FREE=2
# AIMEAT_LOGIN_TARPIT_STEP_MS=4000
# AIMEAT_LOGIN_TARPIT_MAX_DELAY_MS=30000
# AIMEAT_LOGIN_TARPIT_BLOCK_AFTER=12
# AIMEAT_LOGIN_TARPIT_WINDOW_MS=900000
# AIMEAT_LOGIN_TARPIT_MAX_CONCURRENT=50

# ── E-invoice operator (Finvoice delivery) ───────────────────
# '' (default) = Finvoice delivery disabled (email door still works).
# 'mock' = in-process test double (local dev / e2e). 'rest' = generic gateway bridge:
# POST {url}/invoices with the Finvoice XML, bearer-keyed; status from {url}/invoices/{id}.
# The operator-specific adapter (Maventa/Apix) lands after the operator contract is chosen.
# AIMEAT_FINVOICE_OPERATOR=
# AIMEAT_FINVOICE_OPERATOR_URL=
# AIMEAT_FINVOICE_OPERATOR_KEY=

# ── Consent Layer (Phase 0.3) ────────────────────────────────
# AIMEAT_CONSENT_EXPIRY_CHECK_INTERVAL_MS=60000  # How often to check for expired consents (default: 1 min)
# AIMEAT_CONSENT_DEFAULT_SCOPE="federation"       # Default consent scope: private | dmz | federation
# AIMEAT_CONSENT_MAX_PER_AGENT=100                # Max consent grants per agent

# ── TOTP / 2FA (Phase 0.5) ──────────────────────────────────
# AIMEAT_TOTP_ENABLED=true                # Enable TOTP 2FA support
# AIMEAT_TOTP_ISSUER="AIMEAT"             # Issuer name shown in authenticator apps
# AIMEAT_TOTP_PERIOD=30                   # TOTP code period in seconds
# AIMEAT_TOTP_WINDOW=1                    # Acceptable time drift window (±1 period)
# AIMEAT_TOTP_BACKUP_CODE_COUNT=10        # Number of backup codes generated
# AIMEAT_TOTP_SECRET_ENCRYPTION_KEY=""    # Hex-encoded 32-byte AES key for encrypting TOTP secrets
#                                          # Generate: openssl rand -hex 32
# AIMEAT_TOTP_MAX_FAILED_ATTEMPTS=5       # Max failed TOTP attempts before lockout
# AIMEAT_TOTP_LOCKOUT_SECONDS=300         # Lockout duration after max failed attempts (default: 5 min)

# ── Match Notifications (Phase 1.6) ────────────────────────────
# AIMEAT_MATCH_NOTIFICATION_INTERVAL_HOURS=24  # How often to check for new matches
# AIMEAT_MATCH_NOTIFICATION_ENABLED=true        # Operator can disable

# ── AI Matching (Phase 2.1) ─────────────────────────────────
# AIMEAT_MATCHING_ENABLED=true
# AIMEAT_MATCH_INTERVAL_HOURS=24          # How often matching runs
# AIMEAT_MATCH_THRESHOLD=0.5              # Minimum match score (0.0-1.0)
# AIMEAT_MATCH_MAX_SUGGESTIONS=5          # Max suggestions per user per round
# AIMEAT_MATCH_MAX_DISTANCE_KM=100        # Max distance for matching
# AIMEAT_MATCH_COOLDOWN_DAYS=7            # Same pair re-suggested after this

# ── Proactive guidance ────────────────────────────────────────
# Whether the AIs people connect here are told what this node makes possible, so they can offer it
# when it fits what somebody is doing. Every owner has their own switch and it is on until they turn
# it off; this one is yours, and off here means off for everybody. Safe on a public node either way:
# the guidance is a fixed text about this node's own capabilities and carries nobody's data.
# AIMEAT_PROACTIVE_GUIDANCE=true

# ── Marketplace (Phase 2.6) ───────────────────────────────────
# AIMEAT_MARKETPLACE_ENABLED=true           # Enable marketplace feature
# AIMEAT_MARKETPLACE_LISTING_FEE=2          # Listing fee in morsels
# AIMEAT_MARKETPLACE_TX_FEE_PERCENT=5       # Transaction fee percentage (buyer pays)
# AIMEAT_MARKETPLACE_ESCROW=true            # Enable escrow for purchases

# ── Commerce core + fee policy (TARGET-033) ───────────────────
# AIMEAT_MARKETPLACE_FEE_MODE=operator      # Fee destination: operator (credit node operator) | burn (remove from supply)
# AIMEAT_OPERATOR_FEE_ACCOUNT=              # Owner name receiving operator-mode fees (empty = first operator-role owner)
# AIMEAT_COMMERCE_FEE_PERCENT=              # Checkout fee % (empty inherits AIMEAT_MARKETPLACE_TX_FEE_PERCENT)
# AIMEAT_COMMERCE_ENABLED=true              # Checkout sessions (/v1/commerce) + UCP checkout capability
# AIMEAT_COMMERCE_SESSION_TTL_MINUTES=60    # Open checkout-session lifetime
# AIMEAT_MCP_CARD_COMMERCE_TOOLS=inline     # /.well-known/mcp.json commerce_tools block: inline (embed the priced app-tool catalog) | pointer (lean card linking /v1/commerce/tools)
# ── Card settlement (Stripe) — NOTHING TO CONFIGURE HERE ──────
# There is no node-level or platform Stripe key. Every seller brings their OWN secret and sets it on
# themselves (Wallet tab → Selling & payments, PUT /v1/commerce/payout/stripe, or the MCP tool
# aimeat_commerce_psp_set). The charge runs on their account, they are the merchant of record, and
# this node holds neither the key nor the funds. A seller with no key simply cannot take card money;
# morsels, invoice and stablecoin settlement are unaffected.

# ── x402 stablecoin settlement (TARGET-042) — NON-CUSTODIAL stablecoin on a fiat price ──
# The token follows the price: a USD session settles in USDC, a EUR session in EURC. One seller payout
# address receives both. The currencies the node advertises are DERIVED from the assets the configured
# network has, so a currency is never offered unless it can really settle.
# AIMEAT_PACING_TOLL_DEFAULT=0           # Morsels burned per METERED call when the capability declares no toll of its own. Morsels replenish daily with a hard ceiling, so a non-zero value puts an absolute RATE floor under every capability - including money-priced ones, whose only other brake is the buyer's total budget. Applies on every metered path (app tools, exchange runs, agent work, raw extension invokes). 0 = off (existing billing unchanged).
# AIMEAT_TEST_MONEY_HANDLER=false        # TEST ONLY. Registers an in-process EUR/USD double so the money rail is E2E-provable without a PSP or a chain. Leave OFF in prod: with it on, a money-priced call reports settled while no real obligation exists anywhere.
# AIMEAT_X402_ENABLED=false               # Register the x402 PaymentHandler (settles money sessions via the exact scheme + facilitator). OFF by default: advertise the exact scheme only when the node can settle it.
# AIMEAT_X402_NETWORK=base-sepolia        # Network id in the accepts[] exact scheme: base-sepolia (testnet) | base (mainnet). Both carry USDC + EURC. A parameter, not hardcoded — Solana etc. drop in via the network registry (src/commerce/x402-facilitator.ts).
# AIMEAT_X402_FACILITATOR_URL=https://x402.org/facilitator  # Facilitator /verify + /settle base URL (all calls go through safeFetch). The public x402.org one covers Base Sepolia (USDC and EURC alike) but NOT Base mainnet — mainnet needs a facilitator that serves it, e.g. Coinbase CDP.
# AIMEAT_X402_RPC_URL=                    # OPTIONAL read-only JSON-RPC (e.g. https://mainnet.base.org). Used ONLY to check that a seller's payout address is an account, not a contract, before it is saved. Empty = check skipped; a payout setting must not depend on a third party being up.
# AIMEAT_X402_TEST_FACILITATOR=false      # TEST ONLY: an off-chain facilitator double so the x402 chain is E2E-provable without a testnet wallet. NEVER in prod (real settlement = the real facilitator).

# ── Crawlers / Content Signals / Web Bot Auth ──────────────────
# AIMEAT_WEB_BOT_AUTH_SIGN=false           # Sign outbound HTTP (RFC 9421 Web Bot Auth, node Ed25519 key) so peers/CDNs can verify AIMEAT traffic against /.well-known/http-message-signatures-directory. OFF by default: stamps identifying Signature headers on every outbound request (linkability; rare strict endpoints may reject unknown headers). The key directory is always served.
# AIMEAT_AI_TRAINING=deny                  # Allow the AI TRAINING crawlers (GPTBot, ClaudeBot, Google-Extended, Applebot-Extended, meta-externalagent) in robots.txt: 'allow' | 'deny'. Denied by default because a personal node holds one person's data, and a safe public default has to assume that case. Denying keeps the node out of what the models know without being pointed at it, and is a stated preference rather than an enforceable control. The SEARCH and RETRIEVAL bots (OAI-SearchBot, Claude-SearchBot, Claude-User, PerplexityBot, Googlebot, Bingbot, Applebot ...) are always allowed and are NOT affected by this: blocking those would make the node unfindable. aimeat.io runs 'allow'.
# AIMEAT_CONTENT_SIGNAL=""                 # robots.txt Content Signals Policy directive (contentsignals.org), e.g. "search=yes, ai-input=yes, ai-train=no". Leave empty to pair it to AIMEAT_AI_TRAINING so the directive and the per-bot rules cannot contradict each other; set it to override both; 'off' removes the directive.

# ── Front page ─────────────────────────────────────────────────
# AIMEAT_FRONT_PAGE=classic                # Which front page the root serves to browsers: 'classic' (the SPA landing), 'demo' (the static showroom page, public/front-demo.html) or 'os' (the static OS page, public/front-os.html), Finnish siblings by language. One switch so a new front can be staged and flipped without touching anything else; the static pages stay directly reachable at their own paths either way. Anything other than the literal 'demo' or 'os' means classic, so a typo cannot take the front door down.

# ── IndexNow (Bing/Yandex search indexing) ─────────────────────
# Generate a key: openssl rand -hex 16
# After setting, run: pnpm indexnow
# AIMEAT_INDEXNOW_KEY="your-hex-key-here"

# ── Push Notifications / PWA (Phase 3.1) ────────────────────
# Generate VAPID keys: npx web-push generate-vapid-keys
# AIMEAT_PUSH_ENABLED=true
# AIMEAT_VAPID_PUBLIC_KEY=""
# AIMEAT_VAPID_PRIVATE_KEY=""
# AIMEAT_VAPID_SUBJECT="mailto:admin@aimeat.example.com"
# AIMEAT_PUSH_NOTIFY_TYPES="work_assignment,action_request"  # message types that trigger push notification
# AIMEAT_PUSH_COOLDOWN_MIN=5                                 # minimum minutes between notifications per node
# AIMEAT_PUSH_MAX_SUBSCRIPTIONS_PER_NODE=5                   # max push subscriptions per personal node
# AIMEAT_PUSH_MAX_FAILURES=3                                 # auto-remove subscription after N consecutive failures
# AIMEAT_EMAIL_RATE_LIMIT_MIN=30                             # minimum minutes between email notifications per node

# ── EUDIW / Identity Verification (Phase 3.3) ────────────────
# AIMEAT_EUDIW_ENABLED=false
# AIMEAT_EUDIW_CLIENT_ID="aimeat-verifier-001"
# AIMEAT_EUDIW_REDIRECT_URI="https://your-node.example/v1/ghii/verify/eudiw/callback"
# AIMEAT_FTN_ENABLED=false
# AIMEAT_FTN_PROVIDER_URL="https://tunnistautuminen.suomi.fi"
# AIMEAT_FTN_CLIENT_ID=""                                      # OIDC client_id from FTN broker
# AIMEAT_FTN_CLIENT_SECRET=""                                  # OIDC client_secret from FTN broker
# AIMEAT_VC_ISSUER_DID="did:web:your-node.example"
# AIMEAT_NONCE_TTL_SECONDS=300                                 # verification nonce TTL (60-3600)
# AIMEAT_NATIONAL_EID_PID_CLAIM="personal_identity_code"       # FI: personal_identity_code, SE: personalNumber, DK: dk.cpr

# ── Social login — Google sign-in (OIDC) ─────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match the callback below.
# AIMEAT_GOOGLE_OAUTH_ENABLED=false
# AIMEAT_GOOGLE_OAUTH_CLIENT_ID=""                             # OAuth 2.0 client ID from Google Cloud Console
# AIMEAT_GOOGLE_OAUTH_CLIENT_SECRET=""                         # OAuth 2.0 client secret
# AIMEAT_GOOGLE_OAUTH_REDIRECT_URI=""                          # default: <baseUrl>/v1/ghii/login/google/callback

# ── Social login — Casdoor sign-in (OIDC) ────────────────────
# Casdoor is an open-source IdP. In its admin: create an Application, add the redirect URI below,
# then copy the client id/secret here. Casdoor is the authority for its org's accounts, so AIMEAT
# treats emails it returns as verified (enables link-by-email) — only enable IdPs you trust for that.
# AIMEAT_CASDOOR_OAUTH_ENABLED=false
# AIMEAT_CASDOOR_OAUTH_ENDPOINT=""                             # Casdoor server URL, e.g. https://casdoor.example.com
# AIMEAT_CASDOOR_OAUTH_CLIENT_ID=""                            # Application client ID from Casdoor
# AIMEAT_CASDOOR_OAUTH_CLIENT_SECRET=""                        # Application client secret from Casdoor
# AIMEAT_CASDOOR_OAUTH_REDIRECT_URI=""                         # default: <baseUrl>/v1/ghii/login/casdoor/callback

# ── Social login — Microsoft Entra ID sign-in (OIDC) ─────────
# Register an app (free) at https://entra.microsoft.com → App registrations. Add a "Web" platform
# with the redirect URI below and create a client secret. TENANT controls who may sign in:
#   • a Directory (tenant) GUID  → ONLY that org's members (enterprise gating; AIMEAT also checks the
#     `tid` claim and treats the email as verified so members auto-link).
#   • common        → any work/school account AND personal Microsoft accounts (widest).
#   • organizations → any work/school account (any org).  • consumers → personal accounts only.
#
# SEVERAL APPROVED ORGANISATIONS: register the app as multi-tenant, set TENANT to "organizations",
# and list the Directory (tenant) GUIDs in ALLOWED_TENANTS. The node then checks the token's `tid`
# claim against that list and refuses every other tenant and every personal account, and treats the
# email as verified so an invited member's account links on first sign-in. The list is the gate;
# leaving it empty falls back to TENANT alone (a GUID there admits that one org, the word modes
# admit anyone). Do not gate on the email domain instead: a domain is whatever the tenant admin
# added to the directory, `tid` is which directory issued the token.
# AIMEAT_ENTRA_OAUTH_ENABLED=false
# AIMEAT_ENTRA_OAUTH_TENANT="common"                           # tenant GUID | common | organizations | consumers
# AIMEAT_ENTRA_ALLOWED_TENANTS=""                              # comma-separated tenant GUIDs; empty = gate from TENANT alone
# AIMEAT_ENTRA_OAUTH_CLIENT_ID=""                              # Application (client) ID from the app registration
# AIMEAT_ENTRA_OAUTH_CLIENT_SECRET=""                          # Client secret value from the app registration
# AIMEAT_ENTRA_OAUTH_REDIRECT_URI=""                           # default: <baseUrl>/v1/ghii/login/entra/callback

# ── Outbound connections (TARGET-057, aimeat-connect) ────────
# Lets a principal connect THEIR OWN account at an external service (Mastodon, YouTube, Bluesky) so
# an app can publish there on their behalf. The opposite direction from the sign-in blocks above,
# and deliberately its own client: signing IN with Google and PUBLISHING to a Google account are
# different consent and must be separately revocable.
#
# WHICH SECRET GOES WHERE — the distinction that catches everyone:
#   • The values below identify the APPLICATION. One per node, the SAME for every user. If they were
#     per-user, every user would have to create their own Google Cloud project.
#   • The USER's access/refresh token identifies THE ACCOUNT. It is never here: it lives encrypted in
#     the Connection table, keyed by the principal who connected it.
#   • Mastodon has nothing here at all. Its client credentials are issued PER INSTANCE and there are
#     hundreds of instances, so the node registers itself on first contact and remembers the result.
#
# Off by default. An unconfigured provider is absent from discovery and refused at start with a
# reason; nothing here fails open.
# AIMEAT_CONNECTIONS_ENABLED=false
# AIMEAT_CONNECT_GOOGLE_CLIENT_ID=""                           # Google Cloud → Clients → Web application
# AIMEAT_CONNECT_GOOGLE_CLIENT_SECRET=""                       # from the same client; NOT the sign-in client

# LinkedIn, for publishing to a member's own feed. Consumer tier, self-serve: create an app at
# https://www.linkedin.com/developers/apps , add the products "Sign In with LinkedIn using OpenID
# Connect" and "Share on LinkedIn", and set the redirect URL to AIMEAT_CONNECT_REDIRECT_URI.
# There is no review to wait for. Empty means the provider is simply not offered.
AIMEAT_CONNECT_LINKEDIN_CLIENT_ID=
AIMEAT_CONNECT_LINKEDIN_CLIENT_SECRET=

# X, for posting to an account's own timeline. There is no free tier for new developers since
# 2026-02-06; it is pay-per-use with NO monthly minimum, prepaid credits and a spend cap you set
# in the X developer console. Roughly $0.015 per post created. Create an app at
# https://console.x.com , enable OAuth 2.0 with a CONFIDENTIAL client ("Web App, Automated App or Bot"),
# AIMEAT_CONNECT_REDIRECT_URI. Empty means the provider is simply not offered.
AIMEAT_CONNECT_X_CLIENT_ID=
AIMEAT_CONNECT_X_CLIENT_SECRET=
# AIMEAT_CONNECT_REDIRECT_URI=""                               # default: <baseUrl>/v1/connections/callback
#   The redirect URI must match the provider's registration EXACTLY — scheme, port, no trailing
#   slash. A mismatch surfaces only at the provider's consent screen, as redirect_uri_mismatch.

# ── Consul (optional fleet management) ───────────────────────
# Connect to HashiCorp Consul for centralized config management across nodes.
# Values in Consul KV take precedence over file/.env but below database overrides.
# AIMEAT_CONSUL_ENABLED=false
# AIMEAT_CONSUL_URL=http://localhost:8500
# AIMEAT_CONSUL_PREFIX=aimeat/config
# AIMEAT_CONSUL_TOKEN=
# AIMEAT_CONSUL_WATCH_INTERVAL=30
# AIMEAT_CONSUL_DATACENTER=

# ── Cross-Federation (Phase 3.4) ────────────────────────────
# AIMEAT_CROSS_FEDERATION_ENABLED=true
# AIMEAT_MAX_GENESIS_PEERS=10
# AIMEAT_GENESIS_SYNC_INTERVAL_HOURS=6

# ── Federation Data Sync ─────────────────────────────────
# AIMEAT_SYNC_MODE="hybrid"                   # bulk | instant | hybrid
# AIMEAT_SYNC_INTERVAL_HOURS=6                # Scheduled sync fallback interval
# AIMEAT_SYNC_BATCH_DELAY_MS=5000             # Event batching window (instant/hybrid mode)
# AIMEAT_REPLICATION_QUEUE_MAX=10000           # Max replication queue entries
# AIMEAT_REPLICATION_QUEUE_TTL_HOURS=72        # Max age of replication queue entries
# AIMEAT_MAX_CONCURRENT_SYNCS=5               # Max parallel outbound sync operations
# AIMEAT_FEDERATION_TIMEOUT_MS=10000           # Timeout for outbound federation HTTP requests
# AIMEAT_MESSAGE_RETRY_INTERVAL_MS=60000       # Retry interval for queued cross-node direct messages
# AIMEAT_MESSAGE_RETRY_TTL_HOURS=168           # Give up on undelivered direct messages after this (7 days)
# AIMEAT_GENESIS_MEMORY_CACHE=false            # Cache routed genesis memory results locally
# AIMEAT_GENESIS_MEMORY_CACHE_TTL_HOURS=4      # Genesis memory cache TTL

# ── Cookie Consent (for service builders) ────────────────────
# Opt-in cookie consent banner for portal HTML pages.
# Uses vanilla-cookieconsent v3. Disabled by default.
# AIMEAT_COOKIE_CONSENT_ENABLED=false
# AIMEAT_COOKIE_CONSENT_CATEGORIES="necessary,analytics,marketing"
# AIMEAT_COOKIE_CONSENT_POLICY_URL="https://example.com/privacy"

# ── Realtime P2P Rooms ───────────────────────────────────────
# AIMEAT_REALTIME_ENABLED=true                      # Enable realtime room discovery & signaling
# AIMEAT_REALTIME_MAX_ROOMS=100                     # Max concurrent rooms on this node
# AIMEAT_REALTIME_MAX_PEERS_PER_ROOM=20             # Max peers per room
# AIMEAT_REALTIME_ROOM_IDLE_TIMEOUT_MS=3600000      # Empty room cleanup timeout (default: 1h)
# AIMEAT_REALTIME_MAX_MESSAGE_SIZE_BYTES=16384      # Max WebSocket message size (default: 16 KB)
# AIMEAT_STUN_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# AIMEAT_TURN_SERVER=""                              # TURN server URL (e.g. turn:turn.example.com:3478)
# AIMEAT_TURN_USERNAME=""                            # TURN credentials
# AIMEAT_TURN_CREDENTIAL=""
# ── Encrypted Chat ────────────────────────────────────────────
# AIMEAT_ECHAT_ANONYMOUS=false                     # Allow anonymous echat WS connections (default: false)

# ── Node Portal (Site) ──────────────────────────────────────
# AIMEAT_SITE_ENABLED=true                           # Serve portal at GET /
# AIMEAT_SITE_MAX_TEMPLATE_SIZE_KB=512               # Max custom template size
# AIMEAT_SITE_CACHE_TTL_SECONDS=60                   # Resolved HTML cache lifetime
# AIMEAT_SITE_KV_REGION="Helsinki"                   # Custom KV pair → {{kv:region}}
# AIMEAT_SITE_KV_CONTACT="admin@example.fi"          # Custom KV pair → {{kv:contact}}

# ── Node Portal Load-Balancer Sync ──────────────────────────
# AIMEAT_SITE_LB_ENABLED=false                        # Enable LB sync mode (mirrors portal from origin)
# AIMEAT_SITE_LB_ORIGIN_URL=https://aimeat.io         # Origin node URL to sync from
# AIMEAT_SITE_LB_SYNC_INTERVAL_MIN=30                 # Sync interval in minutes
# AIMEAT_SITE_LB_SYNC_ON_STARTUP=true                 # Sync immediately on startup

# ── Setup Wizard (Phase 1.2) ───────────────────────────────
# Restrict setup wizard access to specific IPs (comma-separated, empty = no restriction)
# AIMEAT_SETUP_ALLOWED_IPS=127.0.0.1,::1

# ── Content Moderation ─────────────────────────────────────
# Auto-hide content after this many active flags (default: 5)
# AIMEAT_AUTO_HIDE_THRESHOLD=5

# ── Statistics ──────────────────────────────────────────────
AIMEAT_STATS_ENABLED=true
AIMEAT_STATS_ACCESS=public          # public | authenticated | operator

# ── Scoped Agent Capabilities (REQ-006) ───────────────────────
# AIMEAT_DEFAULT_AGENT_SCOPES="memory:read,memory:write,catalogue:read"
# AIMEAT_MAX_AGENT_SCOPES="*"
# Enforce per-agent scopes on the /v1/mcp tool surface (mirrors REST requireScope gates).
# Default true. Set false for a warn-only rollout: all tools stay registered, but tools that
# WOULD be filtered are logged so you can measure impact before enforcing.
# AIMEAT_MCP_ENFORCE_SCOPES=true
# AIMEAT_MCP_SESSION_IDLE_MINUTES=60      # Close an MCP session idle this long. Each session
#                                         # holds a full tool catalog in memory and most clients never
#                                         # send the closing DELETE; a reaped client re-initializes.
# Same-owner device-auth auto-approval (Agent-Bundled Apps): a device-authorize call
# authenticated as the SAME owner it registers for (the owner session, or one of that
# owner's agents — e.g. crew-forge registering an agent it just deployed) skips the manual
# consent step. Never cross-owner; an agent approver cannot grant scopes beyond its own
# token's; the approval is attributed. Default true (public-safe: no cross-owner reach, no
# scope escalation). Set false to force EVERY registration through the manual consent page.
# AIMEAT_SAME_OWNER_AUTO_APPROVE=true

# ── Ecosystem Applications (GEAI) ──────────────────────────────
# Scope bounds for ecosystem-app (GEAI) connections, parallel to the agent knobs above.
# Defaults lean read + deposit (ecosystem apps mostly deposit refined data into owner areas).
# AIMEAT_DEFAULT_ECO_SCOPES="memory:read,memory:write,organism:read"
# AIMEAT_MAX_ECO_SCOPES="*"
# GEAI credential lifetime in seconds (default 90 days, same class as agent JWTs).
# AIMEAT_ECO_JWT_TTL=7776000

# ── Prometheus Metrics ─────────────────────────────────────
# Prometheus metrics endpoint (GET /v1/metrics)
AIMEAT_METRICS_ENABLED=false
AIMEAT_METRICS_ACCESS=operator      # public | authenticated | operator

# ── Node Extensions (V8 Isolates) ────────────────────────────
# AIMEAT_EXTENSIONS_ENABLED=true       # Extension system (default: true)
# AIMEAT_EXT_MAX_MEMORY_MB=64          # V8 isolate memory limit per action
# AIMEAT_EXT_TIMEOUT_MS=5000           # V8 isolate CPU timeout per action
# AIMEAT_EXT_MAX_API_CALLS=500         # Max AIMEAT API calls per action invocation (1-10000)
# AIMEAT_EXT_MAX_CODE_SIZE_KB=256      # Max JS source size per action
# AIMEAT_EXT_MAX_INSTALLED=20          # Max extensions installed on this node
# AIMEAT_EXT_INSTALL_ROLE=operator     # Role required to install extensions: operator | owner (default: operator)
# AIMEAT_MAX_EXTENSIONS_PER_OWNER=10   # Max extensions per owner when owner-role installs enabled (default: 10)

# ── Service Generator ────────────────────────────────────

# ── Packages & Templates ──────────────────────────────────
# Master switch for the package system
# AIMEAT_PACKAGES_ENABLED=true
# Who can create packages: "operator" (default) or "owner"
# AIMEAT_PACKAGE_CREATE_ROLE=operator
# Maximum total size of all components in a package (MB)
# AIMEAT_PACKAGE_MAX_SIZE_MB=50
# Maximum number of components per package
# AIMEAT_PACKAGE_MAX_COMPONENTS=20
# Maximum packages per author
# AIMEAT_PACKAGE_MAX_PER_AUTHOR=50
# Master switch for template gallery
# AIMEAT_TEMPLATES_ENABLED=true
# Allow reviews on template listings
# AIMEAT_TEMPLATE_REVIEWS_ENABLED=true
# Allow discussions on template listings
# AIMEAT_TEMPLATE_DISCUSSIONS_ENABLED=true
# Enable cross-node template sharing via federation
# AIMEAT_PACKAGE_FEDERATION_ENABLED=false
# Auto-accept federated templates without operator review
# AIMEAT_PACKAGE_FEDERATION_AUTO_ACCEPT=false

# ── Portfolio ──
# AIMEAT_PORTFOLIO=true              # Enable portfolio feature (default: true)
# AIMEAT_PORTFOLIO_MAX_SIZE_KB=512   # Max portfolio HTML file size (default: 512KB)
# AIMEAT_PORTFOLIO_MAX_IMAGES=20     # Max images selectable for portfolio prompt (default: 20)
