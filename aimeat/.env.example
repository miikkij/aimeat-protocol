# AIMEAT Node Configuration
# Copy this file to .env and adjust values for your environment.
# All values shown are defaults — uncomment and change as needed.

# ── Node Identity ──────────────────────────────────────────────
AIMEAT_NODE_ID="aimeat-local-001-dev"
AIMEAT_PORT=40050
# AIMEAT_NODE_TYPE="full"         # full | relay | mirror
# AIMEAT_BASE_URL="https://your-domain.com"  # Public URL (default: http://localhost:$PORT)

# ── Database ───────────────────────────────────────────────────
# Leave empty for in-memory storage (data lost on restart)
# DATABASE_URL="mongodb://user:pass@localhost:27017/AIMEAT?replicaSet=rs0&authSource=admin"

# ── Operator / Admin ───────────────────────────────────────────
# Auto-generated on startup if not set (printed to console)
# AIMEAT_ADMIN_PASSWORD="TestAdminPw123!"

# ── Modes ──────────────────────────────────────────────────────
# Dev mode: bypasses OTK validation on micro-memory
# AIMEAT_DEV_MODE=false

# Anonymous mode: no auth required, all agents share one memory space.
# Runs alongside normal auth — both work simultaneously.
# On startup creates anonymous owner+agent automatically.
# Startup logs will show the anonymous prompt URL and share prompt URL.
# AIMEAT_ANONYMOUS=false

# ── Auth & Tokens ──────────────────────────────────────────────
# AIMEAT_JWT_TTL=3600              # JWT lifetime in seconds (default: 1h)
# AIMEAT_OTK_TTL_MS=300000        # OTK expiry in ms (default: 5min)
# AIMEAT_OTK_GRACE_MS=60000       # OTK grace period in ms (default: 1min)

# ── Morsel Economy ─────────────────────────────────────────────
# AIMEAT_WELCOME_BONUS=100
# AIMEAT_DAILY_ALLOWANCE=50
# AIMEAT_DAILY_ALLOWANCE_CAP=500
# AIMEAT_BURN_RATE=0.10
# AIMEAT_MAX_OPERATOR_MINT_PER_DAY=10000
# AIMEAT_BOARD_POST_BASE_COST=5
# AIMEAT_BOARD_POST_COST_PER_KB=2

# ── Features ───────────────────────────────────────────────────
# AIMEAT_KEYED_BROWSE=true         # Tier 0.5 keyed browse (set "false" to disable)
# AIMEAT_EXTENDED_FEATURES=true    # Boards, federation, storage, validate (set "false" to disable)

# ── Quotas ─────────────────────────────────────────────────────
# AIMEAT_MEMORY_QUOTA_MB=10
# AIMEAT_STORAGE_QUOTA_MB=100
# AIMEAT_MICRO_MEMORY_QUOTA_KB=500
# AIMEAT_MEMORY_OVERAGE_MORSELS=10
# AIMEAT_STORAGE_OVERAGE_MORSELS=100
# AIMEAT_MAX_URL_LENGTH=8192

# ── Federation ─────────────────────────────────────────────────
# AIMEAT_FEDERATION_ROLE="standalone"  # operator | contributor | standalone
# AIMEAT_GENESIS_URL=""                # Genesis node URL (for contributor role)
# AIMEAT_MAX_RELAY_HOPS=3
# AIMEAT_DEPEERING_GRACE_HOURS=72
# AIMEAT_KEY_CACHE_REFRESH_MINUTES=5

# ── Work Queue ─────────────────────────────────────────────────
# AIMEAT_WEBHOOK_MAX_RETRIES=5
# AIMEAT_WORK_QUEUE_MAX_PENDING=10

# ── Rate Limits (requests per second) ─────────────────────────
# AIMEAT_RL_GLOBAL=300
# AIMEAT_RL_AUTH=20
# AIMEAT_RL_WORK=60
# AIMEAT_RL_MEMORY=120
# AIMEAT_RL_BOARDS=60

# ── Personal Nodes ───────────────────────────────────────────
# AIMEAT_PERSONAL_NODES_ENABLED=true
# AIMEAT_PERSONAL_NODE_MAX_SLOTS=100
# AIMEAT_PERSONAL_MAILBOX_QUOTA_MB=50
# AIMEAT_PERSONAL_MAILBOX_RETENTION_DAYS=7
# AIMEAT_PERSONAL_HEARTBEAT_MS=30000
# AIMEAT_PERSONAL_OFFLINE_MS=300000

# ── IndexNow (Bing/Yandex search indexing) ─────────────────────
# Generate a key: openssl rand -hex 16
# After setting, run: pnpm indexnow
# AIMEAT_INDEXNOW_KEY="your-hex-key-here"
