# The repo root ignores "**/src/**/*.js" (compiled output under aimeat/src) and "dist/". Neither
# applies here: src/*.js IS the source, and dist/ is the artefact that was actually published, kept
# so `git log dist/pixel-mirage.html` is the history of what users got. Child rules win over parent
# rules, so re-include both explicitly.
!src/**/*.js
!dist/

# owner token for deploy-ext.mjs and test/live.mjs, never commit
.token
.upload_url
# PIL-generated fixtures and local render output
fixtures/
out/
