# AIMEAT-boosted OpenHands — copy to .env and fill in. The .env is git-ignored.

# ── Which AIMEAT node this instance builds against ──
AIMEAT_BASE_URL=https://aimeat.io
AIMEAT_OWNER=                       # your AIMEAT username (used by aimeat-connect.sh)
AIMEAT_AGENT_NAME=openhands         # 3-64 lowercase alphanumeric + hyphens (openhands#<owner>@<node>)
AIMEAT_SCOPES="*"                   # scopes to request; narrow later if you like. QUOTE this
                                    # value — unquoted globs like `app:*` break `set -a && . ./.env`.

# ── LLM: cheap recycled intelligence via OpenRouter (Kimi K2.7 Code) ──
# Get a key at https://openrouter.ai/keys — this is the ONLY paid piece (~$0.4 / app).
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/moonshotai/kimi-k2.7-code
LLM_BASE_URL=https://openrouter.ai/api/v1

# AIMEAT_AGENT_TOKEN is written by scripts/aimeat-connect.sh into secrets/aimeat.env —
# do not set it here by hand.

# ── Browser access ──
# Where to publish the UI on the host. Default = 3000 on all interfaces (fine for local dev).
# On a shared/prod host, bind localhost-only on a non-default port and reach it via an SSH
# tunnel (ssh -L 13781:localhost:13781 user@host). The container port is always 3000 internally.
# OPENHANDS_PORT_BIND=127.0.0.1:13781
#
# Origins allowed to reach the UI. Must match the origin you actually browse to (scheme + host +
# port), or CORS blocks it with a "Network Error". Comma-separated, no trailing slash.
# Local dev on :3000 works out of the box. Examples:
#   PERMITTED_CORS_ORIGINS=http://localhost:13781
#   PERMITTED_CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000

# ── Reverse-proxy / prod deploy (leave empty for local dev) ──
# Public hostname (no scheme, no path). When set, the app self-links + spawned runtime
# containers reach the default MCP proxy at https://<WEB_HOST>/mcp/mcp — which your nginx
# proxies back to the app. Without this, MCP tool-listing times out for any deploy that
# isn't listening on host port 3000. See nginx/openhands.conf.example for the matching
# reverse-proxy rules (including the /mcp/mcp auth-off exception).
# WEB_HOST=openhands.example.com
#
# Browser-facing URL pattern for spawned runtime containers. Required behind a reverse proxy;
# otherwise the browser receives a naked host_port URL like https://openhands.example.com:56743
# that won't resolve. Nginx must have a matching `location ~ ^/runtime-<port>(/.*)?$` block
# proxying to http://172.17.0.1:<port> (see nginx/openhands.conf.example).
# SANDBOX_CONTAINER_URL_PATTERN=https://openhands.example.com/runtime-{port}
#
# ── Docker daemon requirement for reverse-proxy deploys ──
# Runtime containers publish random host ports. Docker's default is 0.0.0.0 (public), which
# in a shared/prod host is what you want to avoid. Set /etc/docker/daemon.json:
#     { "ip": "172.17.0.1" }
# then `systemctl restart docker`. This binds published ports to the docker0 bridge host-IP,
# which is reachable from the app container and from nginx but NOT from the public internet.
# Requires the daemon.json change to take effect BEFORE any containers are running (live-restore
# skips network reconfig otherwise). If you already have containers up: stop them, restart docker,
# start them again.
