# AIMEAT-boosted OpenHands — copy to .env and fill in. The .env is git-ignored.

# ── Which AIMEAT node this instance builds against ──
AIMEAT_BASE_URL=https://aimeat.io
AIMEAT_OWNER=                       # your AIMEAT username (used by aimeat-connect.sh)
AIMEAT_AGENT_NAME=openhands         # the agent identity name (openhands#<owner>@<node>)
AIMEAT_SCOPES=*                     # scopes to request; narrow later if you like

# ── LLM: cheap recycled intelligence via OpenRouter (Kimi K2.7 Code) ──
# Get a key at https://openrouter.ai/keys — this is the ONLY paid piece (~$0.4 / app).
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/moonshotai/kimi-k2.7-code
LLM_BASE_URL=https://openrouter.ai/api/v1

# AIMEAT_AGENT_TOKEN is written by scripts/aimeat-connect.sh into secrets/aimeat.env —
# do not set it here by hand.
