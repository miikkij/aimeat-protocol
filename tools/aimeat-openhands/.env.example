# AIMEAT-boosted OpenHands — copy to .env and fill in. The .env is git-ignored.

# ── Which AIMEAT node this instance builds against ──
AIMEAT_BASE_URL=https://aimeat.io
AIMEAT_OWNER=                       # your AIMEAT username (used by aimeat-connect.sh)
AIMEAT_AGENT_NAME=openhands         # the agent identity name (openhands#<owner>@<node>)
AIMEAT_SCOPES=*                     # scopes to request; narrow later if you like

# ── LLM: cheap recycled intelligence via OpenRouter (Kimi K2.7 Code) ──
# Get a key at https://openrouter.ai/keys — this is the ONLY paid piece (~$0.4 / app).
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/moonshotai/kimi-k2.7-code
LLM_BASE_URL=https://openrouter.ai/api/v1

# AIMEAT_AGENT_TOKEN is written by scripts/aimeat-connect.sh into secrets/aimeat.env —
# do not set it here by hand.

# ── Browser access ──
# Where to publish the UI on the host. Default = 3000 on all interfaces (fine for local dev).
# On a shared/prod host, bind localhost-only on a non-default port and reach it via an SSH
# tunnel (ssh -L 13781:localhost:13781 user@host). The container port is always 3000 internally.
# OPENHANDS_PORT_BIND=127.0.0.1:13781
#
# Origins allowed to reach the UI. Must match the origin you actually browse to (scheme + host +
# port), or CORS blocks it with a "Network Error". Comma-separated, no trailing slash.
# Local dev on :3000 works out of the box. Examples:
#   PERMITTED_CORS_ORIGINS=http://localhost:13781
#   PERMITTED_CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000
