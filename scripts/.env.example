# scripts/.env — config for scripts/gen_image.py (the AIMEAT image generator).
# Copy this file to scripts/.env and fill in the values. scripts/.env is gitignored — never commit it.

# ── Image generation (required) ──────────────────────────────────────────────
# Your OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The image model to use. When unset, the script tries a built-in candidate list
# (flux.2-pro → gemini-2.5-flash-image → seedream-4.5). Examples:
#   black-forest-labs/flux.2-pro     (crisp, brand-quality; ~$0.03/image floor)
#   google/gemini-2.5-flash-image    (fast, cheap)
#   bytedance-seed/seedream-4.5
IMAGE_MODEL=black-forest-labs/flux.2-pro

# ── Public upload (only needed for --upload) ─────────────────────────────────
# AIMEAT owner login. With --upload the generated image is PUT to AIMEAT storage
# as a public file under this owner's GHII, and the URL/key are logged to
# genimages/uploads.json so a later session can find and reference it.
AIMEAT_APP_LOGIN_USER=
AIMEAT_APP_LOGIN_PASSWORD=

# Optional overrides (sensible defaults shown):
# AIMEAT_BASE=https://aimeat.io
# AIMEAT_NODE_ID=aimeat-finland-001-genesis
