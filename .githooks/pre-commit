#!/bin/sh
#
# AIMEAT pre-commit — the checks that take seconds, and nothing that takes minutes.
#   1. ESLint (src/ + public/), cached              — pnpm lint
#   2. Backend type check, incremental              — pnpm typecheck
#   3. Frontend type check (checkJs), incremental   — pnpm typecheck:frontend
#   4. SDK-libs type check (checkJs), incremental   — pnpm typecheck:sdk
#   5. No silent exception handler in a STAGED file — pnpm check:silent-catch -- --strict --staged
#
# WHY ONLY THESE (2026-09-05). This hook had grown to 45 lines and 7–9 minutes a commit, and when
# it was cut to eight lines and two minutes the developer's answer was still no: a day of iterative
# work is twenty commits and a few pushes, and a check that costs minutes on each of them turns a
# thirty-minute change into a day. So the hook keeps what is warm and fast — about twenty seconds —
# and the rest moves to ONE command run once, when a piece of work is finished:
#
#     pnpm gate          the read-only gates and the five program-reading gates, then only what the
#                        change reaches: the unit tests whose imports touch a changed file, an E2E
#                        suite that itself changed, and the guard tier only when src/routes, auth,
#                        services, storage, mcp or middleware changed (scripts/gate.ts prints why)
#     pnpm gate:full     everything, both backends — a release, a storage change, rarely
#
# CI runs all of it on every push and blocks a merge on it, so nothing is skipped; it is moved to
# where waiting for it costs nobody an afternoon. A session says "done" only after `pnpm gate` is
# green (CLAUDE.md, Gates); a person can push a text change and go on with their day.
#
# The pre-push hook keeps the two things a push must not do to other sessions (push from behind
# origin, push a tree that does not boot) and nothing slower.
#
# Bypass in a genuine emergency with:  git commit --no-verify
#
# Activated via `git config core.hooksPath .githooks` (set automatically by the root
# package.json "prepare" script on `pnpm install`).

set -e

echo "[pre-commit] ESLint, cached (lint)…"
pnpm -s lint

echo "[pre-commit] Type check — backend, incremental (typecheck)…"
pnpm -s typecheck

echo "[pre-commit] Type check — frontend / checkJs (typecheck:frontend)…"
pnpm -s typecheck:frontend

echo "[pre-commit] Type check — SDK libs / checkJs (typecheck:sdk)…"
pnpm -s typecheck:sdk

# A new silent handler can only be in a file this commit touches; the whole tree is CI's pass.
echo "[pre-commit] No silent exception handler in a staged file (check:silent-catch --staged)…"
pnpm -s check:silent-catch -- --strict --staged

echo "[pre-commit] ✓ fast checks passed — run \`pnpm gate\` once when the work is done"
