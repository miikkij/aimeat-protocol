{
  "productName": "AIMEAT Personal Node",
  "version": "0.4.0",
  "identifier": "com.overscale.aimeat-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "AIMEAT Personal Node",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": ["resources/server/**/*", "resources/agent-runtime/**/*", "WebView2Loader.*"]
  }
}
