{
  "productName": "AIMEAT Personal Node",
  "version": "0.4.8",
  "identifier": "com.overscale.aimeat-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "AIMEAT Personal Node",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "externalBin": [
      "binaries/node"
    ],
    "resources": [
      "resources/server/**/*",
      "resources/agent-runtime/**/*",
      "WebView2Loader.*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/miikkij/aimeat-protocol/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxOUNFREU3RjE3OTE1NTcKUldSWEZYbng1KzJjMFRCMFJwTGx5SDBSeXI1KytCL3hHTkQ2MkZ1Q1V3VVFxOUwreXgxeWlPREgK"
    }
  }
}
