{
  "name": "aimeat-protocol",
  "version": "1.30.1",
  "private": true,
  "description": "AIME AT — AI Memory Exchange and Action Transfer — love what you build, share what you know",
  "type": "module",
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "aimeat": "aimeat/dist/bin/aimeat.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "cd aimeat && pnpm build",
    "build-desktop": "cd aimeat-desktop && pnpm package",
    "dev": "cd aimeat && pnpm dev",
    "start": "cd aimeat && pnpm start",
    "link:global": "cd aimeat && npm link",
    "typecheck": "cd aimeat && pnpm typecheck",
    "typecheck:frontend": "cd aimeat && pnpm typecheck:frontend",
    "check:importmap": "cd aimeat && pnpm check:importmap",
    "telemetry:stats": "cd aimeat && pnpm telemetry:stats",
    "telemetry:prune": "cd aimeat && pnpm telemetry:prune",
    "consent-audit:stats": "cd aimeat && pnpm consent-audit:stats",
    "consent-audit:prune": "cd aimeat && pnpm consent-audit:prune",
    "screenshot:worker": "cd aimeat && pnpm screenshot:worker",
    "lint": "cd aimeat && pnpm lint",
    "test": "cd aimeat && pnpm test",
    "test:unit": "cd aimeat && pnpm test",
    "test:e2e": "cd aimeat && node --import tsx test/run-e2e-ci.ts",
    "test:e2e:sqlite": "cd aimeat && pnpm test:e2e:sqlite",
    "test:e2e:mongodb": "cd aimeat && pnpm test:e2e:mongodb",
    "test:e2e:postgresql": "cd aimeat && pnpm test:e2e:postgresql",
    "test:e2e:all": "cd aimeat && node --import tsx test/run-e2e-ci.ts --all",
    "test:e2e:full": "cd aimeat && pnpm test:e2e",
    "test:e2e:federation": "cd aimeat && pnpm test:e2e:federation",
    "test:e2e:federation-mesh": "cd aimeat && pnpm test:e2e:federation-mesh",
    "test:e2e:federation-multinode": "cd aimeat && pnpm test:e2e:federation-multinode",
    "test:e2e:mcp": "cd aimeat && pnpm test:e2e:mcp",
    "test:e2e:disputes": "cd aimeat && pnpm test:e2e:disputes",
    "test:e2e:micro-memory": "cd aimeat && pnpm test:e2e:micro-memory",
    "test:e2e:storage-visibility": "cd aimeat && pnpm test:e2e:storage-visibility",
    "test:e2e:board-ttl": "cd aimeat && pnpm test:e2e:board-ttl",
    "test:e2e:concurrency": "cd aimeat && npx tsx test/e2e-concurrency.ts",
    "test:e2e:hooks": "cd aimeat && npx tsx test/e2e-hooks.ts",
    "test:playwright": "cd aimeat && pnpm test:playwright",
    "test:playwright:sqlite": "cd aimeat && pnpm test:playwright:sqlite",
    "test:playwright:mongodb": "cd aimeat && pnpm test:playwright:mongodb",
    "test:ci": "cd aimeat && node --import tsx test/run-e2e-ci.ts --all",
    "generate:types": "cd aimeat && pnpm generate:types",
    "audit:mcp-tools": "cd aimeat && pnpm audit:mcp-tools"
  }
}
